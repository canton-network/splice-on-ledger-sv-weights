module Splice.Amulet.SvRightOwner where

import Prelude hiding (all, sum)

import DA.Foldable (forA_, all, sum)
import DA.Map (Map)
import qualified DA.Map as Map
import Splice.Types (ForDso(..))
import Splice.Util (HasCheckedFetch(..), Patchable(..), patchScalar, require)

-- | An SV right owner, i.e., an entity that owns SV rights and thereby earns SV rewards.
--
-- SV right owners are hosted by an SV node operator, which mints their rewards on their
-- behalf. Multiple SV right owners can be hosted by the same SV node operator, and an SV
-- node operator is not required to be an SV right owner itself.
template SvRightOwner
  with
    dso : Party
    name : Text -- ^ Human-readable name; unique among all SV right owners.
    shards : [SvRightsMintingShard]
  where
    signatory dso
    ensure all validSvRightsMintingShard shards && uniqueShardIds shards

instance HasCheckedFetch SvRightOwner ForDso where
  contractGroupId SvRightOwner{dso} = ForDso with dso

-- | Information about a super validator right owner.
data SvRightsMintingShard = SvRightsMintingShard
  with
    id : Text
    rightOwnerParty : Party
      -- ^ The party of the SV right owner; receives the rewards not shared with beneficiaries.
    rewardWeight : Int
      -- ^ The weight of an SV Right Owner for reward minting
    rewardNodeOperatorName : Text
      -- ^ Name of the SV node operator through which rewards are minted.
    beneficiaries : Map Party BeneficiaryInfo
      -- ^ Map of beneficiaries and their percentages for reward distribution. Must not include the right owner's party. Remainder goes to right owner.
      -- At most 20 beneficiaries are allowed to bound the number of coupons minted per round.
  deriving (Eq, Show, Serializable)

instance Patchable SvRightsMintingShard where
  patch new base current = SvRightsMintingShard
    with
      id = patch new.id base.id current.id
      rightOwnerParty = patch new.rightOwnerParty base.rightOwnerParty current.rightOwnerParty
      rewardWeight = patch new.rewardWeight base.rewardWeight current.rewardWeight
      rewardNodeOperatorName = patch new.rewardNodeOperatorName base.rewardNodeOperatorName current.rewardNodeOperatorName
      beneficiaries = patch new.beneficiaries base.beneficiaries current.beneficiaries

-- | Information about a beneficiary.
data BeneficiaryInfo = BeneficiaryInfo
  with
    rewardRatio : Decimal
      -- ^ The proportion of rewards of the SV Right Owner that are shared with this beneficiary. It should be >0.0 and <=1.0
  deriving (Eq, Show, Serializable)

instance Patchable BeneficiaryInfo where
  patch new base current = BeneficiaryInfo
    with
      rewardRatio = patchScalar new.rewardRatio base.rewardRatio current.rewardRatio

svRightsMintingShardChecks : [(SvRightsMintingShard -> Bool, Text)]
svRightsMintingShardChecks =
  [ (\SvRightsMintingShard{..} -> rewardWeight >= 0, "SV right owner's reward weight is non-negative")
  , (\SvRightsMintingShard{..} -> all ((> 0.0) . rewardRatio) beneficiaries, "Beneficiary reward ratios are positive")
  , (\SvRightsMintingShard{..} -> sum (fmap (.rewardRatio) beneficiaries) <= 1.0, "Beneficiary reward ratios add up to at most 1.0")
  , (\SvRightsMintingShard{..} -> not $ Map.member rightOwnerParty beneficiaries, "SV right owner is not a beneficiary")
  , (\SvRightsMintingShard{..} -> Map.size beneficiaries <= 20, "There are at most 20 beneficiaries")
  ]

uniqueShardIds : [SvRightsMintingShard] -> Bool
uniqueShardIds shards = Map.size (Map.fromList [(shard.id, ()) | shard <- shards]) == length shards

validSvRightsMintingShard : SvRightsMintingShard -> Bool
validSvRightsMintingShard info = all (\(check, _) -> check info) svRightsMintingShardChecks

requireValidSvRightsMintingShard : SvRightsMintingShard -> Update ()
requireValidSvRightsMintingShard info =
  forA_ svRightsMintingShardChecks $ \(check, message) -> require message (check info)

-- | The absolute reward weight for each party that receives rewards in the context of this SV Right Owner.
svRewardCouponWeights : SvRightsMintingShard -> Map Party Int
svRewardCouponWeights SvRightsMintingShard{..} =
  if remainingWeight > 0
  then Map.insert rightOwnerParty remainingWeight beneficiaryWeights
  else beneficiaryWeights
  where
    remainingWeight = rewardWeight - sum beneficiaryWeights
    beneficiaryWeights = fmap (\BeneficiaryInfo{rewardRatio} -> floor (intToDecimal rewardWeight * rewardRatio)) beneficiaries

-- | Find the shard selected by its stable identifier.
lookupSvRightsMintingShard : Text -> [SvRightsMintingShard] -> Update SvRightsMintingShard
lookupSvRightsMintingShard shardId shards =
  case filter (\shard -> shard.id == shardId) shards of
    [shard] -> pure shard
    _ -> abort "SV rights minting shard does not exist or is not unique"
