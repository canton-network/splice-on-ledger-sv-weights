test_ExpireMigrateToOnLedgerSvRightOwnersInstruction : Script ()
test_ExpireMigrateToOnLedgerSvRightOwnersInstruction = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet
  svRightOwners <- svRightOwnerInfosFromOperators app

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_MigrateToOnLedgerSvRightOwners DsoRules_MigrateToOnLedgerSvRightOwners with
      svRightOwners

  [(instructionCid, _)] <- query @MigrateToOnLedgerSvRightOwnersInstruction dso
  passTime (hours 6)

  openMiningRoundTriple <- getOpenMiningRoundTriple app
  svOperatorRewardStateCids <- getSvOperatorRewardStateCids app
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExecuteMigrateToOnLedgerSvRightOwnersInstruction with
      instructionCid
      openMiningRoundTriple
      svOperatorRewardStateCids
      svOperator = sv1

  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExpireMigrateToOnLedgerSvRightOwnersInstruction with
      instructionCid
      svOperator = sv1

  [] <- query @MigrateToOnLedgerSvRightOwnersInstruction dso
  pure ()

-- | Add a new SV right owner hosted by the SV node operator of the same name.
test_AddSvRightOwner : Script ()
test_AddSvRightOwner = do
  (app, dso, svs@(_, sv2, _, _)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2

  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1", "sv2"])

  [(_, owner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv2")
  owner.info === mkSvRightOwnerInfo sv2 rightOwnerWeight "sv2"

  checkSvContractInvariants app

test_CannotAddDuplicateSvRightOwner : Script ()
test_CannotAddDuplicateSvRightOwner = do
  (app, dso, (sv1, _, _, _)) <- initMainNetWithSvRightOwners
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail dso $
    exerciseCmd dsoRulesCid DsoRules_AddSvRightOwner with
      name = "sv1"
      info = mkSvRightOwnerInfo sv1 rightOwnerWeight "sv1"
  [] <- query @AddSvRightOwnerInstruction dso
  checkSvContractInvariants app

-- | Two additions can be approved before a name is in use, but only one can execute.
test_CannotExecuteDuplicateSvRightOwnerAddition : Script ()
test_CannotExecuteDuplicateSvRightOwnerAddition = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  let add = DsoRules_AddSvRightOwner with
        name = "sv2"
        info = mkSvRightOwnerInfo sv2 rightOwnerWeight "sv2"
  replicateA_ 2 $
    initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
      dsoAction = SRARC_AddSvRightOwner add

  [(firstInstructionCid, _), (secondInstructionCid, _)] <- query @AddSvRightOwnerInstruction dso
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  let execute instructionCid = DsoRules_ExecuteAddSvRightOwnerInstruction with
        instructionCid
        openMiningRoundTriple
        svOperator = sv1
  svSubmits app sv1 $ \cid -> exerciseCmd cid (execute firstInstructionCid)

  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid (execute secondInstructionCid)
  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1", "sv2"])
  checkSvContractInvariants app

test_AddSvRightOwnerRejectsOffboardedOperator : Script ()
test_AddSvRightOwnerRejectsOffboardedOperator = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_AddSvRightOwner DsoRules_AddSvRightOwner with
      name = "hosted-sv"
      info = mkSvRightOwnerInfo sv2 rightOwnerWeight "sv2"
  [(instructionCid, _)] <- query @AddSvRightOwnerInstruction dso

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_OffboardSv DsoRules_OffboardSv with sv = sv2
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExecuteAddSvRightOwnerInstruction with
      instructionCid
      openMiningRoundTriple
      svOperator = sv1
  [] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "hosted-sv")
  checkSvContractInvariants app

test_ExpireAddSvRightOwnerInstruction : Script ()
test_ExpireAddSvRightOwnerInstruction = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_AddSvRightOwner DsoRules_AddSvRightOwner with
      name = "sv2"
      info = mkSvRightOwnerInfo sv2 rightOwnerWeight "sv2"

  [(instructionCid, _)] <- query @AddSvRightOwnerInstruction dso
  passTime (hours 6)

  openMiningRoundTriple <- getOpenMiningRoundTriple app
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExecuteAddSvRightOwnerInstruction with
      instructionCid
      openMiningRoundTriple
      svOperator = sv1

  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExpireAddSvRightOwnerInstruction with
      instructionCid
      sv = Some sv1

  [] <- query @AddSvRightOwnerInstruction dso
  pure ()

test_RemoveSvRightOwner : Script ()
test_RemoveSvRightOwner = do
  (app, dso, svs@(sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with
      name = "sv2"

  [(instructionCid, _)] <- query @RemoveSvRightOwnerInstruction dso
  svRightOwnerCid <- getSvRightOwnerCid app "sv2"
  svRewardStateCid <- getSvRewardStateCid app "sv2"
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteRemoveSvRightOwnerInstruction with
      instructionCid
      svRightOwnerCid
      svRewardStateCid
      svOperator = sv1

  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1"])
  [] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv2")
  [] <- queryFilter @SvRewardState dso (\state -> state.svName == "sv2")
  checkSvContractInvariants app

-- | Check the owner and reward-state names independently when removing sv2.
test_RemoveSvRightOwnerRejectsWrongName : Script ()
test_RemoveSvRightOwnerRejectsWrongName = do
  (app, dso, svs@(sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with name = "sv2"

  [(instructionCid, _)] <- query @RemoveSvRightOwnerInstruction dso
  owner1 <- getSvRightOwnerCid app "sv1"
  owner2 <- getSvRightOwnerCid app "sv2"
  state1 <- getSvRewardStateCid app "sv1"
  state2 <- getSvRewardStateCid app "sv2"
  [(dsoRulesCid, _)] <- query @DsoRules dso
  let remove (svRightOwnerCid, svRewardStateCid) =
        exerciseCmd dsoRulesCid DsoRules_ExecuteRemoveSvRightOwnerInstruction with
          instructionCid
          svRightOwnerCid
          svRewardStateCid
          svOperator = sv1
  forA_ [(owner1, state2), (owner2, state1)] $ \inputs ->
    submitMustFail (actAs sv1 <> readAs dso) $ remove inputs
  _ <- submit (actAs sv1 <> readAs dso) $ remove (owner2, state2)
  checkSvContractInvariants app

test_CannotRemoveLastSvRightOwner : Script ()
test_CannotRemoveLastSvRightOwner = do
  (app, dso, _) <- initMainNetWithSvRightOwners

  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail dso $
    exerciseCmd dsoRulesCid DsoRules_RemoveSvRightOwner with
      name = "sv1"

  [] <- query @RemoveSvRightOwnerInstruction dso
  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1"])
  [_] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  [_] <- queryFilter @SvRewardState dso (\state -> state.svName == "sv1")
  checkSvContractInvariants app

test_CannotExecuteRemovalOfLastSvRightOwner : Script ()
test_CannotExecuteRemovalOfLastSvRightOwner = do
  (app, dso, svs@(sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2

  forA_ ["sv1", "sv2"] $ \name ->
    initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
      dsoAction = SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with name

  let removalCommand name = do
        [(dsoRulesCid, _)] <- query @DsoRules dso
        [(instructionCid, _)] <- queryFilter @RemoveSvRightOwnerInstruction dso (\i -> i.name == name)
        svRightOwnerCid <- getSvRightOwnerCid app name
        svRewardStateCid <- getSvRewardStateCid app name
        pure $ exerciseCmd dsoRulesCid DsoRules_ExecuteRemoveSvRightOwnerInstruction with
          instructionCid
          svRightOwnerCid
          svRewardStateCid
          svOperator = sv1

  removeSv2 <- removalCommand "sv2"
  _ <- submit (actAs sv1 <> readAs dso) removeSv2
  checkSvContractInvariants app

  -- The remaining instruction cannot remove the final owner.
  removeSv1 <- removalCommand "sv1"
  submitMustFail (actAs sv1 <> readAs dso) removeSv1

  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1"])
  [(_, instruction)] <- query @RemoveSvRightOwnerInstruction dso
  instruction.name === "sv1"
  checkSvContractInvariants app

