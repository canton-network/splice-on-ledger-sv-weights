-- | Update the info of an SV right owner by vote.
test_UpdateSvRightOwnerInfo : Script ()
test_UpdateSvRightOwnerInfo = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  [(_, owner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  let newInfo = owner.info with rewardWeight = owner.info.rewardWeight + bpsMultiplier

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
      name = "sv1"
      baseInfo = owner.info
      newInfo

  [(instructionCid, _)] <- query @UpdateSvRightOwnerInfoInstruction dso
  svRightOwnerCid <- getSvRightOwnerCid app "sv1"
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
      instructionCid
      svRightOwnerCid
      svOperator = sv1

  [(_, updatedOwner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  updatedOwner.info === newInfo

test_UpdateSvRightOwnerInfoRejectsWrongName : Script ()
test_UpdateSvRightOwnerInfoRejectsWrongName = do
  (app, dso, svs@(sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2
  [(sv1RightOwnerCid, sv1RightOwner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  sv2RightOwnerCid <- getSvRightOwnerCid app "sv2"
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
      name = "sv1"
      baseInfo = sv1RightOwner.info
      newInfo = sv1RightOwner.info with rewardWeight = rightOwnerWeight

  [(instructionCid, _)] <- query @UpdateSvRightOwnerInfoInstruction dso
  [(dsoRulesCid, _)] <- query @DsoRules dso
  let update svRightOwnerCid = exerciseCmd dsoRulesCid DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
        instructionCid
        svRightOwnerCid
        svOperator = sv1
  submitMustFail (actAs sv1 <> readAs dso) $ update sv2RightOwnerCid
  _ <- submit (actAs sv1 <> readAs dso) $ update sv1RightOwnerCid
  checkSvContractInvariants app

test_UpdateSvRightOwnerInfoRejectsMergedBeneficiariesRewardRatioOverOne : Script ()
test_UpdateSvRightOwnerInfoRejectsMergedBeneficiariesRewardRatioOverOne = do
  (app, dso, svs@(_, sv2, sv3, _)) <- initMainNetWithSvRightOwners
  [(_, owner)] <- query @SvRightOwner dso
  let newInfo = owner.info with
        beneficiaries = Map.fromList [(sv2, BeneficiaryInfo 0.6)]
      concurrentBeneficiaries = Map.fromList [(sv3, BeneficiaryInfo 0.6)]
  checkSvRightOwnerUpdateRejectsMergedInfo app svs newInfo concurrentBeneficiaries

test_UpdateSvRightOwnerInfoRejectsMergedSelfBeneficiary : Script ()
test_UpdateSvRightOwnerInfoRejectsMergedSelfBeneficiary = do
  (app, dso, svs@(_, sv2, _, _)) <- initMainNetWithSvRightOwners
  [(_, owner)] <- query @SvRightOwner dso
  let newInfo = owner.info with rightOwnerParty = sv2
      concurrentBeneficiaries = Map.fromList [(sv2, BeneficiaryInfo 0.25)]
  checkSvRightOwnerUpdateRejectsMergedInfo app svs newInfo concurrentBeneficiaries

test_UpdateSvRightOwnerInfoRejectsOffboardedOperator : Script ()
test_UpdateSvRightOwnerInfoRejectsOffboardedOperator = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  [(svRightOwnerCid, owner)] <- query @SvRightOwner dso
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
      name = "sv1"
      baseInfo = owner.info
      newInfo = owner.info with rewardNodeOperatorName = "sv2"
  [(instructionCid, _)] <- query @UpdateSvRightOwnerInfoInstruction dso

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_OffboardSv DsoRules_OffboardSv with sv = sv2
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
      instructionCid
      svRightOwnerCid
      svOperator = sv1
  [(unchangedCid, unchangedOwner)] <- query @SvRightOwner dso
  (unchangedCid, unchangedOwner) === (svRightOwnerCid, owner)

test_ExpireUpdateSvRightOwnerInfoInstruction : Script ()
test_ExpireUpdateSvRightOwnerInfoInstruction = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  [(_, owner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
      name = "sv1"
      baseInfo = owner.info
      newInfo = owner.info with rewardWeight = owner.info.rewardWeight + bpsMultiplier

  [(instructionCid, _)] <- query @UpdateSvRightOwnerInfoInstruction dso
  passTime (hours 6)

  svRightOwnerCid <- getSvRightOwnerCid app "sv1"
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
      instructionCid
      svRightOwnerCid
      svOperator = sv1

  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExpireUpdateSvRightOwnerInfoInstruction with
      instructionCid
      svOperator = sv1

  [] <- query @UpdateSvRightOwnerInfoInstruction dso
  [(_, unchangedOwner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  unchangedOwner.info === owner.info

-- | An SV right owner shares its rewards with a beneficiary, which needs no vote.
test_UpdateSvRightOwnerBeneficiaries : Script ()
test_UpdateSvRightOwnerBeneficiaries = do
  (app, dso, (sv1, sv2, _, _)) <- initMainNetWithSvRightOwners
  let beneficiaries = Map.fromList [(sv2, BeneficiaryInfo with rewardRatio = 0.25)]

  svRightOwnerCid <- getSvRightOwnerCid app "sv1"
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_UpdateSvRightOwnerBeneficiaries with
      name = "sv1"
      svRightOwnerCid
      beneficiaries
      rightOwner = sv1

  [(_, owner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  owner.info.beneficiaries === beneficiaries

test_UpdateSvRightOwnerBeneficiariesRejectsWrongName : Script ()
test_UpdateSvRightOwnerBeneficiariesRejectsWrongName = do
  (app, dso, svs@(_, sv2, _, _)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2
  svRightOwnerCid <- getSvRightOwnerCid app "sv2"
  [(dsoRulesCid, _)] <- query @DsoRules dso
  -- Use the supplied contract's actual owner, so only the name is wrong.
  let update name = exerciseCmd dsoRulesCid DsoRules_UpdateSvRightOwnerBeneficiaries with
        name
        svRightOwnerCid
        beneficiaries = Map.empty
        rightOwner = sv2
  submitMustFail (actAs sv2 <> readAs dso) $ update "sv1"
  _ <- submit (actAs sv2 <> readAs dso) $ update "sv2"
  checkSvContractInvariants app

-- | Mint one SV reward coupon per beneficiary of an SV right owner, with the remainder of its
-- weight going to the right owner itself.
test_ReceiveSvRewardCouponV2 : Script ()
test_ReceiveSvRewardCouponV2 = do
  (app, dso, (sv1, sv2, _, _)) <- initMainNetWithSvRightOwners
  let rewardRatio = 0.25

  svRightOwnerCid <- getSvRightOwnerCid app "sv1"
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_UpdateSvRightOwnerBeneficiaries with
      name = "sv1"
      svRightOwnerCid
      beneficiaries = Map.fromList [(sv2, BeneficiaryInfo with rewardRatio)]
      rightOwner = sv1

  -- Round 0 opens at bootstrap time, and rewards can only be minted for an open round.
  passTime (hours 6)
  [(updatedSvRightOwnerCid, owner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  svRewardStateCid <- getSvRewardStateCid app "sv1"
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ReceiveSvRewardCouponV2 with
      svOperator = sv1
      openRoundCid = openMiningRoundTriple.round0Cid
      svRightOwnerRewardInputs = TextMap.fromList [("sv1", (updatedSvRightOwnerCid, svRewardStateCid))]

  let beneficiaryWeight = floor (intToDecimal owner.info.rewardWeight * rewardRatio)
  coupons <- queryFilter @SvRewardCoupon dso (\coupon -> coupon.round == Round 0 && coupon.sv == sv1)
  sort [(coupon.beneficiary, coupon.weight) | (_, coupon) <- coupons] ===
    sort [(sv1, owner.info.rewardWeight - beneficiaryWeight), (sv2, beneficiaryWeight)]

  [(_, rewardState)] <- queryFilter @SvRewardState dso (\state -> state.svName == "sv1")
  rewardState.state.lastRoundCollected === Round 0

test_ReceiveSvRewardCouponV2RejectsWrongOwnerName : Script ()
test_ReceiveSvRewardCouponV2RejectsWrongOwnerName =
  checkSvRewardCouponV2RejectsWrongName "sv2" "sv1"

test_ReceiveSvRewardCouponV2RejectsWrongRewardStateName : Script ()
test_ReceiveSvRewardCouponV2RejectsWrongRewardStateName =
  checkSvRewardCouponV2RejectsWrongName "sv1" "sv2"

test_ReceiveSvRewardCouponV2RejectsWrongMapKey : Script ()
test_ReceiveSvRewardCouponV2RejectsWrongMapKey =
  checkSvRewardCouponV2RejectsWrongName "sv2" "sv2"

-- | A beneficiary allocation that rounds down to zero must not prevent the remaining coupons
-- from being created. The zero-weight beneficiary should receive no coupon.
test_ReceiveSvRewardCouponV2LowWeight : Script ()
test_ReceiveSvRewardCouponV2LowWeight = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  [(_, owner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")

  let ratioFlooringToZero = 0.1

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
      name = "sv1"
      baseInfo = owner.info
      newInfo = owner.info with rewardWeight = 3

  [(instructionCid, _)] <- query @UpdateSvRightOwnerInfoInstruction dso
  svRightOwnerCid <- getSvRightOwnerCid app "sv1"
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
      instructionCid
      svRightOwnerCid
      svOperator = sv1

  updatedSvRightOwnerCid <- getSvRightOwnerCid app "sv1"
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_UpdateSvRightOwnerBeneficiaries with
      name = "sv1"
      svRightOwnerCid = updatedSvRightOwnerCid
      beneficiaries = Map.fromList
        [ (sv2, BeneficiaryInfo with rewardRatio = ratioFlooringToZero)
        , (sv3, BeneficiaryInfo with rewardRatio = 0.5)
        ]
      rightOwner = sv1

  passTime (hours 6)
  rewardOwnerCid <- getSvRightOwnerCid app "sv1"
  svRewardStateCid <- getSvRewardStateCid app "sv1"
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ReceiveSvRewardCouponV2 with
      svOperator = sv1
      openRoundCid = openMiningRoundTriple.round0Cid
      svRightOwnerRewardInputs = TextMap.fromList [("sv1", (rewardOwnerCid, svRewardStateCid))]

  coupons <- queryFilter @SvRewardCoupon dso (\coupon -> coupon.round == Round 0 && coupon.sv == sv1)
  sort [(coupon.beneficiary, coupon.weight) | (_, coupon) <- coupons] ===
    sort [(sv1, 2), (sv3, 1)]

-- | SV reward coupons that nobody claims expire into unclaimed rewards once their round closes,
-- including the coupons minted for the beneficiaries of an SV right owner.
test_ExpireSvRewardCoupons : Script ()
test_ExpireSvRewardCoupons = do
  (app, dso, (sv1, sv2, _, _)) <- initMainNetWithSvRightOwners

  svRightOwnerCid <- getSvRightOwnerCid app "sv1"
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_UpdateSvRightOwnerBeneficiaries with
      name = "sv1"
      svRightOwnerCid
      beneficiaries = Map.fromList [(sv2, BeneficiaryInfo with rewardRatio = 0.25)]
      rightOwner = sv1

  passTime (hours 6)
  [(updatedSvRightOwnerCid, _)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  svRewardStateCid <- getSvRewardStateCid app "sv1"
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ReceiveSvRewardCouponV2 with
      svOperator = sv1
      openRoundCid = openMiningRoundTriple.round0Cid
      svRightOwnerRewardInputs = TextMap.fromList [("sv1", (updatedSvRightOwnerCid, svRewardStateCid))]

  minted <- queryFilter @SvRewardCoupon dso (\coupon -> coupon.round == Round 0)
  length minted === 2

  -- Round 0 has to reach its closed phase before its coupons can expire.
  replicateA_ 5 $ runNextIssuanceD app 1.0 None

  [] <- queryFilter @SvRewardCoupon dso (\coupon -> coupon.round == Round 0)
  _ :: _ <- query @UnclaimedReward dso
  pure ()

-- | The reward weight given to the SV right owners added by these tests: that of a Tier 2 SV.
rightOwnerWeight : Int
rightOwnerWeight = 3 * bpsMultiplier

mkSvRightOwnerInfo : Party -> Int -> Text -> SvRightOwnerInfo
mkSvRightOwnerInfo rightOwner weight operatorName = SvRightOwnerInfo with
  rightOwnerParty = rightOwner
  rewardWeight = weight
  rewardNodeOperatorName = operatorName
  beneficiaries = Map.empty

-- | The SV node operators as SV right owners of their own name, preserving the total weight.
svRightOwnerInfosFromOperators : AmuletApp -> Script (TextMap.TextMap SvRightOwnerInfo)
svRightOwnerInfosFromOperators app = do
  [(_, dsoRules)] <- query @DsoRules app.dso
  pure $ TextMap.fromList
    [ (info.name, mkSvRightOwnerInfo party info.svRewardWeight info.name)
    | (party, info) <- Map.toList dsoRules.svs
    ]

-- | Vote in an SV right owner hosted by the SV node operator of the same name, and execute
-- the resulting instruction.
addSvRightOwner : AmuletApp -> (Party, Party, Party, Party) -> Text -> Party -> Script ()
addSvRightOwner app (sv1, sv2, sv3, sv4) name rightOwnerParty = do
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_AddSvRightOwner DsoRules_AddSvRightOwner with
      name
      info = mkSvRightOwnerInfo rightOwnerParty rightOwnerWeight name

  [(instructionCid, _)] <- query @AddSvRightOwnerInstruction app.dso
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteAddSvRightOwnerInstruction with
      instructionCid
      openMiningRoundTriple
      svOperator = sv1
  pure ()

-- | Submit the named owner and reward state under the map key "sv1".
checkSvRewardCouponV2RejectsWrongName : Text -> Text -> Script ()
checkSvRewardCouponV2RejectsWrongName rightOwnerName rewardStateName = do
  (app, dso, svs@(_, sv2, _, _)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2
  (openRoundCid, openRound) <- last <$> getOpenRoundsSorted app
  setTime openRound.opensAt
  [(svRightOwnerCid, owner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == rightOwnerName)
  svRewardStateCid <- getSvRewardStateCid app rewardStateName
  [(dsoRulesCid, dsoRules)] <- query @DsoRules dso
  [svOperator] <- pure
    [party | (party, info) <- Map.toList dsoRules.svs, info.name == owner.info.rewardNodeOperatorName]
  let mint name rewardStateCid = exerciseCmd dsoRulesCid DsoRules_ReceiveSvRewardCouponV2 with
        svOperator
        openRoundCid
        svRightOwnerRewardInputs = TextMap.fromList [(name, (svRightOwnerCid, rewardStateCid))]
  submitMustFail (actAs svOperator <> readAs dso) $ mint "sv1" svRewardStateCid

  correctRewardStateCid <- getSvRewardStateCid app rightOwnerName
  _ <- submit (actAs svOperator <> readAs dso) $ mint rightOwnerName correctRewardStateCid
  checkSvContractInvariants app

checkMigrationRejectsWrongRewardStateName
  : AmuletApp -> (Party, Party, Party, Party) -> TextMap.TextMap SvRightOwnerInfo -> Script ()
checkMigrationRejectsWrongRewardStateName app (sv1, sv2, sv3, sv4) svRightOwners = do
  let dso = app.dso
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_MigrateToOnLedgerSvRightOwners DsoRules_MigrateToOnLedgerSvRightOwners with
      svRightOwners

  [(instructionCid, _)] <- query @MigrateToOnLedgerSvRightOwnersInstruction dso
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  rewardStates <- getSvOperatorRewardStateCids app
  sv1RewardStateCid <- getSvRewardStateCid app "sv1"
  sv2RewardStateCid <- getSvRewardStateCid app "sv2"
  [(dsoRulesCid, _)] <- query @DsoRules dso
  let migrate states = exerciseCmd dsoRulesCid DsoRules_ExecuteMigrateToOnLedgerSvRightOwnersInstruction with
        instructionCid
        openMiningRoundTriple
        svOperatorRewardStateCids = states
        svOperator = sv1
  submitMustFail (actAs sv1 <> readAs dso) $
    migrate (TextMap.insert "sv1" sv2RewardStateCid $ TextMap.insert "sv2" sv1RewardStateCid rewardStates)
  _ <- submit (actAs sv1 <> readAs dso) $ migrate rewardStates
  checkSvContractInvariants app

-- | Approve an update, change beneficiaries independently, then check the merged result.
checkSvRightOwnerUpdateRejectsMergedInfo
  : AmuletApp -> (Party, Party, Party, Party) -> SvRightOwnerInfo -> Map.Map Party BeneficiaryInfo -> Script ()
checkSvRightOwnerUpdateRejectsMergedInfo app (sv1, sv2, sv3, sv4) newInfo concurrentBeneficiaries = do
  let dso = app.dso
  [(svRightOwnerCid, owner)] <- query @SvRightOwner dso
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
      name = "sv1"
      baseInfo = owner.info
      newInfo
  [(instructionCid, _)] <- query @UpdateSvRightOwnerInfoInstruction dso

  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_UpdateSvRightOwnerBeneficiaries with
      name = "sv1"
      svRightOwnerCid
      beneficiaries = concurrentBeneficiaries
      rightOwner = sv1
  [(currentOwnerCid, currentOwner)] <- query @SvRightOwner dso
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
      instructionCid
      svRightOwnerCid = currentOwnerCid
      svOperator = sv1
  [(unchangedCid, unchangedOwner)] <- query @SvRightOwner dso
  (unchangedCid, unchangedOwner) === (currentOwnerCid, currentOwner)
