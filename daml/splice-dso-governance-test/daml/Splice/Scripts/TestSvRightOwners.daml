module Splice.Scripts.TestSvRightOwners where

import DA.Assert
import qualified DA.Map as Map
import qualified DA.Set as Set
import qualified DA.TextMap as TextMap
import DA.Time

import Daml.Script

import Splice.Amulet.SvRightOwner
import Splice.DSO.SvState
import Splice.DsoRules
import Splice.Scripts.DsoTestUtils
import Splice.Scripts.Util

-- | Migrate the SV node operators of the test network to SV right owners of the same name.
test_MigrateToOnLedgerSvRightOwners : Script ()
test_MigrateToOnLedgerSvRightOwners = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet
  svRightOwners <- svRightOwnerInfosFromOperators app

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_MigrateToOnLedgerSvRightOwners DsoRules_MigrateToOnLedgerSvRightOwners with
      svRightOwners

  [(instructionCid, _)] <- query @MigrateToOnLedgerSvRightOwnersInstruction dso
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  svOperatorRewardStateCids <- getSvOperatorRewardStateCids app
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteMigrateToOnLedgerSvRightOwnersInstruction with
      instructionCid
      openMiningRoundTriple
      svOperatorRewardStateCids
      svOperator = sv1

  [(_, dsoRules)] <- query @DsoRules dso
  [info.svRewardWeight | info <- Map.values dsoRules.svs] === [0, 0, 0, 0]
  dsoRules.svRightOwners === Some (Set.fromList ["sv1", "sv2", "sv3", "sv4"])

  owners <- query @SvRightOwner dso
  TextMap.fromList [(owner.name, owner.info) | (_, owner) <- owners] === svRightOwners

test_ExpireMigrateToOnLedgerSvRightOwnersInstruction : Script ()
test_ExpireMigrateToOnLedgerSvRightOwnersInstruction = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet
  svRightOwners <- svRightOwnerInfosFromOperators app

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_MigrateToOnLedgerSvRightOwners DsoRules_MigrateToOnLedgerSvRightOwners with
      svRightOwners

  [(instructionCid, _)] <- query @MigrateToOnLedgerSvRightOwnersInstruction dso
  passTime (hours 2)

  openMiningRoundTriple <- getOpenMiningRoundTriple app
  svOperatorRewardStateCids <- getSvOperatorRewardStateCids app
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExecuteMigrateToOnLedgerSvRightOwnersInstruction with
      instructionCid
      openMiningRoundTriple
      svOperatorRewardStateCids
      svOperator = sv1

  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExpireMigrateToOnLedgerSvRightOwnersInstruction with
      instructionCid
      svOperator = sv1

  [] <- query @MigrateToOnLedgerSvRightOwnersInstruction dso
  pure ()

-- | Add a new SV right owner hosted by the SV node operator of the same name.
test_AddSvRightOwner : Script ()
test_AddSvRightOwner = do
  (app, dso, svs@(_, sv2, _, _)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2

  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1", "sv2"])

  [(_, owner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv2")
  owner.info === mkSvRightOwnerInfo sv2 rightOwnerWeight "sv2"

  checkSvContractInvariants app

test_ExpireAddSvRightOwnerInstruction : Script ()
test_ExpireAddSvRightOwnerInstruction = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_AddSvRightOwner DsoRules_AddSvRightOwner with
      name = "sv2"
      info = mkSvRightOwnerInfo sv2 rightOwnerWeight "sv2"

  [(instructionCid, _)] <- query @AddSvRightOwnerInstruction dso
  passTime (hours 2)

  openMiningRoundTriple <- getOpenMiningRoundTriple app
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExecuteAddSvRightOwnerInstruction with
      instructionCid
      openMiningRoundTriple
      svOperator = sv1

  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExpireAddSvRightOwnerInstruction with
      instructionCid
      sv = Some sv1

  [] <- query @AddSvRightOwnerInstruction dso
  pure ()

test_RemoveSvRightOwner : Script ()
test_RemoveSvRightOwner = do
  (app, dso, svs@(sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with
      name = "sv2"

  [(instructionCid, _)] <- query @RemoveSvRightOwnerInstruction dso
  svRightOwnerCid <- getSvRightOwnerCid app "sv2"
  svRewardStateCid <- getSvRewardStateCid app "sv2"
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteRemoveSvRightOwnerInstruction with
      instructionCid
      svRightOwnerCid
      svRewardStateCid
      svOperator = sv1

  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1"])
  [] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv2")
  [] <- queryFilter @SvRewardState dso (\state -> state.svName == "sv2")
  checkSvContractInvariants app

test_CannotRemoveLastSvRightOwner : Script ()
test_CannotRemoveLastSvRightOwner = do
  (app, dso, _) <- initMainNetWithSvRightOwners

  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail dso $
    exerciseCmd dsoRulesCid DsoRules_RemoveSvRightOwner with
      name = "sv1"

  [] <- query @RemoveSvRightOwnerInstruction dso
  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1"])
  [(_, _)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  [(_, _)] <- queryFilter @SvRewardState dso (\state -> state.svName == "sv1")
  checkSvContractInvariants app

test_ExpireRemoveSvRightOwnerInstruction : Script ()
test_ExpireRemoveSvRightOwnerInstruction = do
  (app, dso, svs@(sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with
      name = "sv2"

  [(instructionCid, _)] <- query @RemoveSvRightOwnerInstruction dso
  svRightOwnerCid <- getSvRightOwnerCid app "sv2"
  svRewardStateCid <- getSvRewardStateCid app "sv2"
  passTime (hours 2)

  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExecuteRemoveSvRightOwnerInstruction with
      instructionCid
      svRightOwnerCid
      svRewardStateCid
      svOperator = sv1

  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExpireRemoveSvRightOwnerInstruction with
      instructionCid
      svOperator = sv1

  [] <- query @RemoveSvRightOwnerInstruction dso
  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1", "sv2"])
  [(_, _)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv2")
  [(_, _)] <- queryFilter @SvRewardState dso (\state -> state.svName == "sv2")
  checkSvContractInvariants app

-- | The reward weight given to the SV right owners added by these tests: that of a Tier 2 SV.
rightOwnerWeight : Int
rightOwnerWeight = 3 * bpsMultiplier

mkSvRightOwnerInfo : Party -> Int -> Text -> SvRightOwnerInfo
mkSvRightOwnerInfo rightOwner weight operatorName = SvRightOwnerInfo with
  rightOwnerParty = rightOwner
  rewardWeight = weight
  rewardNodeOperatorName = operatorName
  beneficiaries = Map.empty

-- | The SV node operators as SV right owners of their own name, preserving the total weight.
svRightOwnerInfosFromOperators : AmuletApp -> Script (TextMap.TextMap SvRightOwnerInfo)
svRightOwnerInfosFromOperators app = do
  [(_, dsoRules)] <- query @DsoRules app.dso
  pure $ TextMap.fromList
    [ (info.name, mkSvRightOwnerInfo party info.svRewardWeight info.name)
    | (party, info) <- Map.toList dsoRules.svs
    ]

-- | Vote in an SV right owner hosted by the SV node operator of the same name, and execute
-- the resulting instruction.
addSvRightOwner : AmuletApp -> (Party, Party, Party, Party) -> Text -> Party -> Script ()
addSvRightOwner app (sv1, sv2, sv3, sv4) name rightOwnerParty = do
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_AddSvRightOwner DsoRules_AddSvRightOwner with
      name
      info = mkSvRightOwnerInfo rightOwnerParty rightOwnerWeight name

  [(instructionCid, _)] <- query @AddSvRightOwnerInstruction app.dso
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteAddSvRightOwnerInstruction with
      instructionCid
      openMiningRoundTriple
      svOperator = sv1
  pure ()
