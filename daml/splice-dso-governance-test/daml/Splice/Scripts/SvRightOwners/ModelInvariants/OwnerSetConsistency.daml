-- | The rules, live owners and reward states describe the same non-empty set.
module Splice.Scripts.SvRightOwners.ModelInvariants.OwnerSetConsistency where

import DA.Assert
import DA.Foldable (forA_)
import qualified DA.Set as Set
import Daml.Script
import Splice.Amulet.SvRightOwner
import Splice.DSO.SvState
import Splice.DsoRules
import Splice.Scripts.DsoTestUtils
import Splice.Scripts.SvRightOwners.TestUtils

test_RemoveSvRightOwner : Script ()
test_RemoveSvRightOwner = do
  (app, dso, svs@(sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with
      name = "sv2"

  [(instructionCid, _)] <- query @RemoveSvRightOwnerInstruction dso
  svRightOwnerCid <- getSvRightOwnerCid app "sv2"
  svRewardStateCid <- getSvRewardStateCid app "sv2"
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteRemoveSvRightOwnerInstruction with
      instructionCid
      svRightOwnerCid
      svRewardStateCid
      svOperator = sv1

  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1"])
  [] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv2")
  [] <- queryFilter @SvRewardState dso (\state -> state.svName == "sv2")
  checkSvContractInvariants app

test_CannotRemoveLastSvRightOwner : Script ()
test_CannotRemoveLastSvRightOwner = do
  (app, dso, _) <- initMainNetWithSvRightOwners

  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail dso $
    exerciseCmd dsoRulesCid DsoRules_RemoveSvRightOwner with
      name = "sv1"

  [] <- query @RemoveSvRightOwnerInstruction dso
  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1"])
  [_] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  [_] <- queryFilter @SvRewardState dso (\state -> state.svName == "sv1")
  checkSvContractInvariants app

test_CannotExecuteRemovalOfLastSvRightOwner : Script ()
test_CannotExecuteRemovalOfLastSvRightOwner = do
  (app, dso, svs@(sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2

  forA_ ["sv1", "sv2"] $ \name ->
    initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
      dsoAction = SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with name

  let removalCommand name = do
        [(dsoRulesCid, _)] <- query @DsoRules dso
        [(instructionCid, _)] <- queryFilter @RemoveSvRightOwnerInstruction dso (\i -> i.name == name)
        svRightOwnerCid <- getSvRightOwnerCid app name
        svRewardStateCid <- getSvRewardStateCid app name
        pure $ exerciseCmd dsoRulesCid DsoRules_ExecuteRemoveSvRightOwnerInstruction with
          instructionCid
          svRightOwnerCid
          svRewardStateCid
          svOperator = sv1

  removeSv2 <- removalCommand "sv2"
  _ <- submit (actAs sv1 <> readAs dso) removeSv2
  checkSvContractInvariants app

  -- The remaining instruction cannot remove the final owner.
  removeSv1 <- removalCommand "sv1"
  submitMustFail (actAs sv1 <> readAs dso) removeSv1

  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1"])
  [(_, instruction)] <- query @RemoveSvRightOwnerInstruction dso
  instruction.name === "sv1"
  checkSvContractInvariants app
