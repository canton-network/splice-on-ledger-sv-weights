-- | Owner and operator names are unique within their separate live sets, but may overlap.
-- Migration reuses an operator's reward state for an owner with the same name.
module Splice.Scripts.SvRightOwners.ModelInvariants.TestNameNamespaces where

import DA.Action (replicateA_)
import DA.Assert
import qualified DA.Set as Set
import Daml.Script
import Splice.DsoRules
import Splice.Types
import Splice.Scripts.DsoTestUtils
import Splice.Scripts.SvRightOwners.Util.Fixture

test_CannotAddDuplicateSvRightOwner = withOnLedgerWeights $ \net -> do
  let app = net.app
      dso = app.dso
      sv1 = net.sv1.party
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail dso $
    exerciseCmd dsoRulesCid DsoRules_AddSvRightOwner with
      name = "sv1"
      info = svRightOwnerInfoFor sv1 tier2RewardWeight "sv1"
  [] <- query @AddSvRightOwnerInstruction dso
  checkSvContractInvariants app

-- | Two additions can be approved before a name is in use, but only one can execute.
test_CannotExecuteDuplicateSvRightOwnerAddition = withOnLedgerWeights $ \net -> do
  let app = net.app
      dso = app.dso
      sv1 = net.sv1.party
      sv2 = net.sv2.party
      sv3 = net.sv3.party
      sv4 = net.sv4.party
  let add = DsoRules_AddSvRightOwner with
        name = "sv2"
        info = svRightOwnerInfoFor sv2 tier2RewardWeight "sv2"
  replicateA_ 2 $
    initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
      dsoAction = SRARC_AddSvRightOwner add

  [(firstInstructionCid, _), (secondInstructionCid, _)] <- query @AddSvRightOwnerInstruction dso
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  let execute instructionCid = DsoRules_ExecuteAddSvRightOwnerInstruction with
        instructionCid
        openMiningRoundTriple
        svOperator = sv1
  svSubmits app sv1 $ \cid -> exerciseCmd cid (execute firstInstructionCid)

  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid (execute secondInstructionCid)
  [(_, dsoRules)] <- query @DsoRules dso
  dsoRules.svRightOwners === Some (Set.fromList ["sv1", "sv2"])
  checkSvContractInvariants app

-- | A second live operator cannot take an existing operator's name in on-ledger mode.
test_CannotAddDuplicateSvNodeOperatorName = withOnLedgerWeights $ \net -> do
  let app = net.app
      dso = app.dso
  newSvParty <- allocateParty "new-operator"
  [(dsoRulesCid, _)] <- query @DsoRules dso
  let add = DsoRules_AddSv with
        newSvParty
        newSvName = "sv2"
        newSvRewardWeight = 0
        newSvParticipantId = "new-operator-participant-id"
        joinedAsOfRound = Round 0
  submitMustFail dso $ exerciseCmd dsoRulesCid add
  _ <- submit dso $ exerciseCmd dsoRulesCid (add with newSvName = "new-operator")
  checkSvContractInvariants app

-- | Adding an operator with an existing owner's name must not replace its reward state.
test_AddSvNodeOperatorWithRightOwnerName = withOnLedgerWeights $ \net -> do
  let app = net.app
      dso = app.dso
      sv1 = net.sv1.party
      sv2 = net.sv2.party
      sv3 = net.sv3.party
      sv4 = net.sv4.party
  rightOwner <- allocateParty "right-owner"
  newSvParty <- allocateParty "new-operator"
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_AddSvRightOwner DsoRules_AddSvRightOwner with
      name = "hosted-sv"
      info = svRightOwnerInfoFor rightOwner tier2RewardWeight "sv1"
  [(instructionCid, _)] <- query @AddSvRightOwnerInstruction dso
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteAddSvRightOwnerInstruction with
      instructionCid
      openMiningRoundTriple
      svOperator = sv1
  ownerCidBefore <- getSvRightOwnerCid app "hosted-sv"
  rewardStateCidBefore <- getSvRewardStateCid app "hosted-sv"

  [(dsoRulesCid, _)] <- query @DsoRules dso
  _ <- submit dso $ exerciseCmd dsoRulesCid DsoRules_AddSv with
    newSvParty
    newSvName = "hosted-sv"
    newSvRewardWeight = 0
    newSvParticipantId = "new-operator-participant-id"
    joinedAsOfRound = Round 0

  operatorInfo <- getSvInfoByParty app newSvParty
  operatorInfo.name === "hosted-sv"
  ownerCidAfter <- getSvRightOwnerCid app "hosted-sv"
  rewardStateCidAfter <- getSvRewardStateCid app "hosted-sv"
  ownerCidAfter === ownerCidBefore
  rewardStateCidAfter === rewardStateCidBefore
  checkSvContractInvariants app
