module Splice.Scripts.SvRightOwners.ModelInvariants.TestNameNamespaces where

import Splice.Scripts.SvRightOwners.Util.Fixture
import Splice.Scripts.SvRightOwners.Util.Governance

test_shouldRejectAddingAnSvNodeOperatorWhoseNameIsAlreadyTaken = withOnLedgerWeights $ \net -> do
  duplicate <- newSvNodeOperator net.sv2.name
  newcomer <- newSvNodeOperator "new-operator"

  onboard net duplicate >>= shouldBeRejected "SV is not currently onboarded"
  onboard net newcomer >>= shouldSucceed

test_shouldPreserveTheRightOwnersRewardStateWhenAddingAnSvNodeOperatorWithItsName = withOnLedgerWeights $ \net -> do
  owner <- newSvRightOwner "hosted-sv" net.sv1
  operator <- newSvNodeOperator owner.svRightsMintingShardId
  instruction <- voteToAdd net owner

  execute net net.sv1.party instruction >>= shouldSucceed
  ownerCidBefore <- svRightOwnerCidFor net owner.svRightsMintingShardId
  rewardStateCidBefore <- svRewardStateCidFor net owner.svRightsMintingShardId

  onboard net operator >>= shouldSucceed

  svNodeOperators net `shouldReturn` [operator, net.sv1, net.sv2, net.sv3, net.sv4]
  svRightOwnerCidFor net owner.svRightsMintingShardId `shouldReturn` ownerCidBefore
  svRewardStateCidFor net owner.svRightsMintingShardId `shouldReturn` rewardStateCidBefore
