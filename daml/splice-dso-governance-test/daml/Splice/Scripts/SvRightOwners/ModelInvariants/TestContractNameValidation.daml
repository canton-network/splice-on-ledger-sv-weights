-- | Choices reject contracts supplied under the wrong name.
module Splice.Scripts.SvRightOwners.ModelInvariants.TestContractNameValidation where

import DA.Functor (void)
import DA.Action (unless)
import DA.List (last)
import DA.Text (isInfixOf)
import qualified DA.Map as Map
import qualified DA.TextMap as TextMap
import Daml.Script
import Splice.Amulet.SvRightOwner
import Splice.DsoRules
import Splice.DSO.SvState
import Splice.Scripts.DsoTestUtils
import Splice.Scripts.SvRightOwners.Util.Fixture hiding (SvRightOwner)
import Splice.Scripts.SvRightOwners.Util.Governance
import Splice.Scripts.Util

test_shouldRejectMigrationWithAReusedRewardState = withLegacyWeights $ \net -> do
  instruction <- migrationRequestedFor net =<< svRightOwnerInfosFromOperators net.app
  rewardStates <- getSvOperatorRewardStateCids net.app

  swapRewardStateNames net rewardStates >>= migrate net instruction >>= shouldBeRejected contractNameMismatch
  migrate net instruction rewardStates >>= shouldSucceed

test_shouldRejectMigrationWithAnArchivedRewardState = withLegacyWeights $ \net -> do
  owners <- svRightOwnerInfosFromOperators net.app
  instruction <- migrationRequestedFor net $ TextMap.fromList
    [("hosted-" <> name, info) | (name, info) <- TextMap.toList owners]
  rewardStates <- getSvOperatorRewardStateCids net.app

  swapRewardStateNames net rewardStates >>= migrate net instruction >>= shouldBeRejected contractNameMismatch
  migrate net instruction rewardStates >>= shouldSucceed

test_shouldRejectRemovingAnOwnerWithContractsNamedForDifferentOwners = withOnLedgerWeights $ \net -> do
  instruction <- removalRequestedFor net "sv2"

  remove net instruction "sv1" "sv2" >>= shouldBeRejected contractNameMismatch
  remove net instruction "sv2" "sv1" >>= shouldBeRejected contractNameMismatch
  remove net instruction "sv2" "sv2" >>= shouldSucceed

test_shouldRejectUpdatingOwnerInfoWithAContractNamedForAnotherOwner = withOnLedgerWeights $ \net -> do
  instruction <- infoUpdateRequestedFor net "sv1"

  updateInfo net instruction "sv2" >>= shouldBeRejected contractNameMismatch
  updateInfo net instruction "sv1" >>= shouldSucceed

test_shouldRejectUpdatingBeneficiariesUnderAnotherOwnersName = withOnLedgerWeights $ \net -> do
  addOwnerNamed net "sv2"

  updateBeneficiaries net "sv1" "sv2" >>= shouldBeRejected contractNameMismatch
  updateBeneficiaries net "sv2" "sv2" >>= shouldSucceed

test_shouldRejectRewardCouponWithAnOwnerNamedForAnotherKey = withOnLedgerWeights $ \net -> do
  addOwnerNamed net "sv2"

  rewardCoupon net "sv1" "sv2" "sv1" >>= shouldBeRejected contractNameMismatch
  rewardCoupon net "sv2" "sv2" "sv2" >>= shouldSucceed

test_shouldRejectRewardCouponWithARewardStateNamedForAnotherKey = withOnLedgerWeights $ \net -> do
  addOwnerNamed net "sv2"

  rewardCoupon net "sv1" "sv1" "sv2" >>= shouldBeRejected contractNameMismatch
  rewardCoupon net "sv1" "sv1" "sv1" >>= shouldSucceed

test_shouldRejectRewardCouponWithTheWrongMapKey = withOnLedgerWeights $ \net -> do
  addOwnerNamed net "sv2"

  rewardCoupon net "sv1" "sv2" "sv2" >>= shouldBeRejected contractNameMismatch
  rewardCoupon net "sv2" "sv2" "sv2" >>= shouldSucceed

data Attempt = Attempt with
  submittedBy : Party
  disclosedTo : Party
  command : Commands ()

contractNameMismatch : Text
contractNameMismatch = "Contract group identifier mismatch"

shouldBeRejected : Text -> Attempt -> Script ()
shouldBeRejected expectedReason (Attempt with submittedBy; disclosedTo; command) = do
  outcome <- trySubmit (actAs submittedBy <> readAs disclosedTo) command
  case outcome of
    Right _ -> fail $ "expected a rejection because " <> show expectedReason
    Left failure -> do
      let reportedReason = case failure of
            FailureStatusError status -> status.message
            other -> show other
      unless (expectedReason `isInfixOf` reportedReason) $
        fail $ "expected a rejection because " <> show expectedReason <> ", not: " <> reportedReason

shouldSucceed : Attempt -> Script ()
shouldSucceed (Attempt with submittedBy; disclosedTo; command) = do
  _ <- submit (actAs submittedBy <> readAs disclosedTo) command
  pure ()

migrationRequestedFor
  : Network -> TextMap.TextMap SvRightOwnerInfo -> Script (ContractId MigrateToOnLedgerSvRightOwnersInstruction)
migrationRequestedFor net owners = do
  initiateAndAcceptVote net.app [net.sv1.party, net.sv2.party, net.sv3.party, net.sv4.party] $ ARC_DsoRules with
    dsoAction = SRARC_MigrateToOnLedgerSvRightOwners DsoRules_MigrateToOnLedgerSvRightOwners with
      svRightOwners = owners
  [(instructionCid, _)] <- query @MigrateToOnLedgerSvRightOwnersInstruction net.app.dso
  pure instructionCid

migrate
  : Network -> ContractId MigrateToOnLedgerSvRightOwnersInstruction -> TextMap.TextMap (ContractId SvRewardState) -> Script Attempt
migrate net instructionCid rewardStates = do
  openMiningRoundTriple <- getOpenMiningRoundTriple net.app
  (dsoRulesCid, _) <- currentDsoRules net
  pure Attempt with
    submittedBy = net.sv1.party
    disclosedTo = net.app.dso
    command = void $ exerciseCmd dsoRulesCid DsoRules_ExecuteMigrateToOnLedgerSvRightOwnersInstruction with
      instructionCid; openMiningRoundTriple; svOperatorRewardStateCids = rewardStates; svOperator = net.sv1.party

swapRewardStateNames
  : Network -> TextMap.TextMap (ContractId SvRewardState) -> Script (TextMap.TextMap (ContractId SvRewardState))
swapRewardStateNames net rewardStates = do
  sv1RewardStateCid <- getSvRewardStateCid net.app "sv1"
  sv2RewardStateCid <- getSvRewardStateCid net.app "sv2"
  pure $ TextMap.insert "sv1" sv2RewardStateCid $ TextMap.insert "sv2" sv1RewardStateCid rewardStates

removalRequestedFor : Network -> Text -> Script (ContractId RemoveSvRightOwnerInstruction)
removalRequestedFor net name = do
  addOwnerNamed net name
  initiateAndAcceptVote net.app [net.sv1.party, net.sv2.party, net.sv3.party, net.sv4.party] $ ARC_DsoRules with
    dsoAction = SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with name
  [(instructionCid, _)] <- query @RemoveSvRightOwnerInstruction net.app.dso
  pure instructionCid

remove : Network -> ContractId RemoveSvRightOwnerInstruction -> Text -> Text -> Script Attempt
remove net instructionCid ownerName rewardStateName = do
  svRightOwnerCid <- getSvRightOwnerCid net.app ownerName
  svRewardStateCid <- getSvRewardStateCid net.app rewardStateName
  (dsoRulesCid, _) <- currentDsoRules net
  pure Attempt with
    submittedBy = net.sv1.party
    disclosedTo = net.app.dso
    command = void $ exerciseCmd dsoRulesCid DsoRules_ExecuteRemoveSvRightOwnerInstruction with
      instructionCid; svRightOwnerCid; svRewardStateCid; svOperator = net.sv1.party

infoUpdateRequestedFor : Network -> Text -> Script (ContractId UpdateSvRightOwnerInfoInstruction)
infoUpdateRequestedFor net name = do
  addOwnerNamed net "sv2"
  [(_, owner)] <- queryFilter @SvRightOwner net.app.dso (\owner -> owner.name == name)
  initiateAndAcceptVote net.app [net.sv1.party, net.sv2.party, net.sv3.party, net.sv4.party] $ ARC_DsoRules with
    dsoAction = SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
      name; baseInfo = owner.info; newInfo = owner.info with rewardWeight = tier2RewardWeight
  [(instructionCid, _)] <- query @UpdateSvRightOwnerInfoInstruction net.app.dso
  pure instructionCid

updateInfo : Network -> ContractId UpdateSvRightOwnerInfoInstruction -> Text -> Script Attempt
updateInfo net instructionCid ownerName = do
  svRightOwnerCid <- getSvRightOwnerCid net.app ownerName
  (dsoRulesCid, _) <- currentDsoRules net
  pure Attempt with
    submittedBy = net.sv1.party
    disclosedTo = net.app.dso
    command = void $ exerciseCmd dsoRulesCid DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
      instructionCid; svRightOwnerCid; svOperator = net.sv1.party

updateBeneficiaries : Network -> Text -> Text -> Script Attempt
updateBeneficiaries net name ownerName = do
  svRightOwnerCid <- getSvRightOwnerCid net.app ownerName
  (dsoRulesCid, _) <- currentDsoRules net
  pure Attempt with
    submittedBy = net.sv2.party
    disclosedTo = net.app.dso
    command = void $ exerciseCmd dsoRulesCid DsoRules_UpdateSvRightOwnerBeneficiaries with
      name; svRightOwnerCid; beneficiaries = Map.empty; rightOwner = net.sv2.party

-- | Build a coupon submission as map key, supplied owner, supplied reward state.
rewardCoupon : Network -> Text -> Text -> Text -> Script Attempt
rewardCoupon net mapKey ownerName rewardStateName = do
  (openRoundCid, openRound) <- last <$> getOpenRoundsSorted net.app
  setTime openRound.opensAt
  [(svRightOwnerCid, owner)] <- queryFilter @SvRightOwner net.app.dso (\owner -> owner.name == ownerName)
  svRewardStateCid <- getSvRewardStateCid net.app rewardStateName
  (dsoRulesCid, dsoRules) <- currentDsoRules net
  [svOperator] <- pure [party | (party, info) <- Map.toList dsoRules.svs, info.name == owner.info.rewardNodeOperatorName]
  pure Attempt with
    submittedBy = svOperator
    disclosedTo = net.app.dso
    command = void $ exerciseCmd dsoRulesCid DsoRules_ReceiveSvRewardCouponV2 with
      svOperator; openRoundCid
      svRightOwnerRewardInputs = TextMap.fromList [(mapKey, (svRightOwnerCid, svRewardStateCid))]

addOwnerNamed : Network -> Text -> Script ()
addOwnerNamed net name =
  addSvRightOwner net.app (net.sv1.party, net.sv2.party, net.sv3.party, net.sv4.party) name net.sv2.party
