-- | Choices reject contracts supplied under the wrong name.
module Splice.Scripts.SvRightOwners.ModelInvariants.ContractNameValidation where

import DA.Foldable (forA_)
import DA.List (last)
import qualified DA.Map as Map
import qualified DA.TextMap as TextMap
import Daml.Script
import Splice.Amulet.SvRightOwner
import Splice.DsoRules
import Splice.Scripts.DsoTestUtils
import Splice.Scripts.SvRightOwners.TestUtils
import Splice.Scripts.Util

test_MigrationRejectsWrongReusedRewardStateName : Script ()
test_MigrationRejectsWrongReusedRewardStateName = do
  (app, _, svs) <- initMainNet
  svRightOwners <- svRightOwnerInfosFromOperators app
  checkMigrationRejectsWrongRewardStateName app svs svRightOwners

test_MigrationRejectsWrongArchivedRewardStateName : Script ()
test_MigrationRejectsWrongArchivedRewardStateName = do
  (app, _, svs) <- initMainNet
  operatorInfos <- svRightOwnerInfosFromOperators app
  let svRightOwners = TextMap.fromList
        [("hosted-" <> name, info) | (name, info) <- TextMap.toList operatorInfos]
  checkMigrationRejectsWrongRewardStateName app svs svRightOwners

-- | Check the owner and reward-state names independently when removing sv2.
test_RemoveSvRightOwnerRejectsWrongName : Script ()
test_RemoveSvRightOwnerRejectsWrongName = do
  (app, dso, svs@(sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with name = "sv2"

  [(instructionCid, _)] <- query @RemoveSvRightOwnerInstruction dso
  owner1 <- getSvRightOwnerCid app "sv1"
  owner2 <- getSvRightOwnerCid app "sv2"
  state1 <- getSvRewardStateCid app "sv1"
  state2 <- getSvRewardStateCid app "sv2"
  [(dsoRulesCid, _)] <- query @DsoRules dso
  let remove (svRightOwnerCid, svRewardStateCid) =
        exerciseCmd dsoRulesCid DsoRules_ExecuteRemoveSvRightOwnerInstruction with
          instructionCid
          svRightOwnerCid
          svRewardStateCid
          svOperator = sv1
  forA_ [(owner1, state2), (owner2, state1)] $ \inputs ->
    submitMustFail (actAs sv1 <> readAs dso) $ remove inputs
  _ <- submit (actAs sv1 <> readAs dso) $ remove (owner2, state2)
  checkSvContractInvariants app

test_UpdateSvRightOwnerInfoRejectsWrongName : Script ()
test_UpdateSvRightOwnerInfoRejectsWrongName = do
  (app, dso, svs@(sv1, sv2, sv3, sv4)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2
  [(sv1RightOwnerCid, sv1RightOwner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == "sv1")
  sv2RightOwnerCid <- getSvRightOwnerCid app "sv2"
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
      name = "sv1"
      baseInfo = sv1RightOwner.info
      newInfo = sv1RightOwner.info with rewardWeight = rightOwnerWeight

  [(instructionCid, _)] <- query @UpdateSvRightOwnerInfoInstruction dso
  [(dsoRulesCid, _)] <- query @DsoRules dso
  let update svRightOwnerCid = exerciseCmd dsoRulesCid DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
        instructionCid
        svRightOwnerCid
        svOperator = sv1
  submitMustFail (actAs sv1 <> readAs dso) $ update sv2RightOwnerCid
  _ <- submit (actAs sv1 <> readAs dso) $ update sv1RightOwnerCid
  checkSvContractInvariants app

test_UpdateSvRightOwnerBeneficiariesRejectsWrongName : Script ()
test_UpdateSvRightOwnerBeneficiariesRejectsWrongName = do
  (app, dso, svs@(_, sv2, _, _)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2
  svRightOwnerCid <- getSvRightOwnerCid app "sv2"
  [(dsoRulesCid, _)] <- query @DsoRules dso
  -- Use the supplied contract's actual owner, so only the name is wrong.
  let update name = exerciseCmd dsoRulesCid DsoRules_UpdateSvRightOwnerBeneficiaries with
        name
        svRightOwnerCid
        beneficiaries = Map.empty
        rightOwner = sv2
  submitMustFail (actAs sv2 <> readAs dso) $ update "sv1"
  _ <- submit (actAs sv2 <> readAs dso) $ update "sv2"
  checkSvContractInvariants app

test_ReceiveSvRewardCouponV2RejectsWrongOwnerName : Script ()
test_ReceiveSvRewardCouponV2RejectsWrongOwnerName =
  checkSvRewardCouponV2RejectsWrongName "sv2" "sv1"

test_ReceiveSvRewardCouponV2RejectsWrongRewardStateName : Script ()
test_ReceiveSvRewardCouponV2RejectsWrongRewardStateName =
  checkSvRewardCouponV2RejectsWrongName "sv1" "sv2"

test_ReceiveSvRewardCouponV2RejectsWrongMapKey : Script ()
test_ReceiveSvRewardCouponV2RejectsWrongMapKey =
  checkSvRewardCouponV2RejectsWrongName "sv2" "sv2"

-- | Submit the named owner and reward state under the map key "sv1".
checkSvRewardCouponV2RejectsWrongName : Text -> Text -> Script ()
checkSvRewardCouponV2RejectsWrongName rightOwnerName rewardStateName = do
  (app, dso, svs@(_, sv2, _, _)) <- initMainNetWithSvRightOwners
  addSvRightOwner app svs "sv2" sv2
  (openRoundCid, openRound) <- last <$> getOpenRoundsSorted app
  setTime openRound.opensAt
  [(svRightOwnerCid, owner)] <- queryFilter @SvRightOwner dso (\owner -> owner.name == rightOwnerName)
  svRewardStateCid <- getSvRewardStateCid app rewardStateName
  [(dsoRulesCid, dsoRules)] <- query @DsoRules dso
  [svOperator] <- pure
    [party | (party, info) <- Map.toList dsoRules.svs, info.name == owner.info.rewardNodeOperatorName]
  let mint name rewardStateCid = exerciseCmd dsoRulesCid DsoRules_ReceiveSvRewardCouponV2 with
        svOperator
        openRoundCid
        svRightOwnerRewardInputs = TextMap.fromList [(name, (svRightOwnerCid, rewardStateCid))]
  submitMustFail (actAs svOperator <> readAs dso) $ mint "sv1" svRewardStateCid

  correctRewardStateCid <- getSvRewardStateCid app rightOwnerName
  _ <- submit (actAs svOperator <> readAs dso) $ mint rightOwnerName correctRewardStateCid
  checkSvContractInvariants app

checkMigrationRejectsWrongRewardStateName
  : AmuletApp -> (Party, Party, Party, Party) -> TextMap.TextMap SvRightOwnerInfo -> Script ()
checkMigrationRejectsWrongRewardStateName app (sv1, sv2, sv3, sv4) svRightOwners = do
  let dso = app.dso
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_MigrateToOnLedgerSvRightOwners DsoRules_MigrateToOnLedgerSvRightOwners with
      svRightOwners

  [(instructionCid, _)] <- query @MigrateToOnLedgerSvRightOwnersInstruction dso
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  rewardStates <- getSvOperatorRewardStateCids app
  sv1RewardStateCid <- getSvRewardStateCid app "sv1"
  sv2RewardStateCid <- getSvRewardStateCid app "sv2"
  [(dsoRulesCid, _)] <- query @DsoRules dso
  let migrate states = exerciseCmd dsoRulesCid DsoRules_ExecuteMigrateToOnLedgerSvRightOwnersInstruction with
        instructionCid
        openMiningRoundTriple
        svOperatorRewardStateCids = states
        svOperator = sv1
  submitMustFail (actAs sv1 <> readAs dso) $
    migrate (TextMap.insert "sv1" sv2RewardStateCid $ TextMap.insert "sv2" sv1RewardStateCid rewardStates)
  _ <- submit (actAs sv1 <> readAs dso) $ migrate rewardStates
  checkSvContractInvariants app
