module Splice.Scripts.SvRightOwners.Migration.TestOffboardedHosts where

import Splice.Scripts.SvRightOwners.Util.Fixture
import Splice.Scripts.SvRightOwners.Util.Governance
import Splice.Scripts.SvRightOwners.Util.Rewards (mintThrough)
import Splice.Scripts.Util (runNextIssuance)

test_shouldLetOnlyTheCurrentSvNodeOperatorUnderTheHostNameMintForItsOwners = withLegacyWeights $ \net -> do
  migrateDefault net
  owner <- newSvRightOwner "hosted-owner" net.sv2
  addSvRightOwner net owner
  hostedBefore <- svRightOwners net
  offboardSvNodeOperator net net.sv2
  returning <- (\successor -> successor with name = net.sv2.name) <$> newSvNodeOperator "returning-sv2"
  onboard net returning >>= shouldSucceed
  runNextIssuance net.app

  mintThrough net net.sv2 owner.name >>= shouldBeRejected "Not a sv"
  mintThrough net returning owner.name >>= shouldSucceed
  svRightOwners net `shouldReturn` [if hosted.hostedBy == net.sv2 then hosted with hostedBy = returning else hosted | hosted <- hostedBefore]

test_shouldKeepHostedOwnersRewardStatesWhenTheirOperatorIsOffboarded = withLegacyWeights $ \net -> do
  migrateDefault net
  owner <- newSvRightOwner "hosted-owner" net.sv2
  addSvRightOwner net owner
  rewardState <- svRewardStateCidFor net owner.name
  offboardSvNodeOperator net net.sv2

  expectActive net rewardState
  svRewardStateNames net `shouldReturn` ["hosted-owner", "sv1", "sv2", "sv3", "sv4"]

test_shouldNotRepairAnOffboardedHostingLinkWithoutAGovernanceVote = withLegacyWeights $ \net -> do
  migrateDefault net
  owner <- newSvRightOwner "hosted-owner" net.sv2
  addSvRightOwner net owner
  offboardSvNodeOperator net net.sv2

  ownerCid <- svRightOwnerCidFor net owner.name
  currentOwner <- contractPayload net ownerCid
  pure currentOwner.info `shouldReturn` svRightOwnerInfo owner
