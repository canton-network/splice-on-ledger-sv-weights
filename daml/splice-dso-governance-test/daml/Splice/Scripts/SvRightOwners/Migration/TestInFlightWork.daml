module Splice.Scripts.SvRightOwners.Migration.TestInFlightWork where

import Daml.Script

import Splice.Scripts.SvRightOwners.Util.Fixture
import Splice.Scripts.SvRightOwners.Util.Governance

test_shouldRefuseAnInFlightLegacyRewardWeightUpdateAfterMigration = withLegacyWeights $ \net -> do
  migrateDefault net

  updateLegacyWeight net net.sv2.party tier2RewardWeight >>= shouldBeRejected "svRightOwners are not tracked on-ledger"

test_shouldAllowAnInFlightMigrationInstructionToExpireAfterItsDeadline = withLegacyWeights $ \net -> do
  owners <- svRightOwnerInfosFromOperators net.app
  instruction <- migrationRequestedFor net owners

  expireMigration net net.sv1.party instruction >>= shouldBeRejected "Ledger time is strictly before deadline"
  instructionExpiresAt net instruction >>= setTime
  expireMigration net net.sv1.party instruction >>= shouldSucceed
  expectArchived net instruction
