module Splice.Scripts.SvRightOwners.TestUtils where

import qualified DA.Map as Map
import qualified DA.TextMap as TextMap
import Daml.Script
import Splice.Amulet.SvRightOwner
import Splice.DsoRules
import Splice.Scripts.DsoTestUtils
import Splice.Scripts.Util

-- | The reward weight given to the SV right owners added by these tests: that of a Tier 2 SV.
rightOwnerWeight : Int
rightOwnerWeight = 3 * bpsMultiplier

mkSvRightOwnerInfo : Party -> Int -> Text -> SvRightOwnerInfo
mkSvRightOwnerInfo rightOwner weight operatorName = SvRightOwnerInfo with
  rightOwnerParty = rightOwner
  rewardWeight = weight
  rewardNodeOperatorName = operatorName
  beneficiaries = Map.empty

-- | The SV node operators as SV right owners of their own name, preserving the total weight.
svRightOwnerInfosFromOperators : AmuletApp -> Script (TextMap.TextMap SvRightOwnerInfo)
svRightOwnerInfosFromOperators app = do
  [(_, dsoRules)] <- query @DsoRules app.dso
  pure $ TextMap.fromList
    [ (info.name, mkSvRightOwnerInfo party info.svRewardWeight info.name)
    | (party, info) <- Map.toList dsoRules.svs
    ]

-- | Vote in an SV right owner hosted by the SV node operator of the same name, and execute
-- the resulting instruction.
addSvRightOwner : AmuletApp -> (Party, Party, Party, Party) -> Text -> Party -> Script ()
addSvRightOwner app (sv1, sv2, sv3, sv4) name rightOwnerParty = do
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_AddSvRightOwner DsoRules_AddSvRightOwner with
      name
      info = mkSvRightOwnerInfo rightOwnerParty rightOwnerWeight name

  [(instructionCid, _)] <- query @AddSvRightOwnerInstruction app.dso
  openMiningRoundTriple <- getOpenMiningRoundTriple app
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteAddSvRightOwnerInstruction with
      instructionCid
      openMiningRoundTriple
      svOperator = sv1
  pure ()

-- | Vote to change an owner's weight and execute the resulting instruction.
updateSvWeight : AmuletApp -> (Party, Party, Party, Party) -> Text -> Int -> Script ()
updateSvWeight app (sv1, sv2, sv3, sv4) ownerName weight = do
  [(svRightOwnerCid, owner)] <- queryFilter @SvRightOwner app.dso (\owner -> owner.name == ownerName)
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
      name = ownerName
      baseInfo = owner.info
      newInfo = owner.info with rewardWeight = weight
  [(instructionCid, _)] <- query @UpdateSvRightOwnerInfoInstruction app.dso
  svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
      instructionCid
      svRightOwnerCid
      svOperator = sv1
  pure ()
