module Splice.Scripts.SvRightOwners.AddingChangingAndRemoving.TestUpdatingAnOwner where

import DA.List (last, sort)
import qualified DA.TextMap as TextMap
import DA.Time (addRelTime)

import Daml.Script

import Splice.DSO.SvState (SvRightsOwnerRewardState(..))
import Splice.DsoRules (UpdateSvRightOwnerInfoInstruction(..))

import Splice.Scripts.SvRightOwners.Util.Fixture
import Splice.Scripts.SvRightOwners.Util.Governance
import Splice.Scripts.SvRightOwners.Util.Rewards (couponsMintedFor, mintThrough, mintWith)
import Splice.Scripts.Util (getOpenRoundsSorted, runNextIssuance)

test_shouldUpdateTheSvRightOwnerWeightAndKeepItsRewardState = withTwoSvRightOwners $ \net newcomer -> do
  firstBeneficiary <- allocateParty "first-beneficiary"
  secondBeneficiary <- allocateParty "second-beneficiary"
  let base = svRightOwnerInfo newcomer
      raised = newcomer with rewardWeight = tier1RewardWeight
  updateAs net net.app.dso "no-such-owner" base base >>= shouldBeRejected "SV right owner \"no-such-owner\" exists"
  updateAs net net.app.dso newcomer.name base (svRightOwnerInfo (newcomer with hostedBy = (newcomer.hostedBy with name = "no-such-operator"))) >>= shouldBeRejected "SV right owner's node operator must exist"
  updateAs net net.app.dso newcomer.name base (svRightOwnerInfo (newcomer with beneficiaries = sharingWith [(firstBeneficiary, 0.6), (secondBeneficiary, 0.5)]))
    >>= shouldBeRejected "Beneficiaries cannot be changed through DsoRules_UpdateSvRightOwnerInfo"
  updateAs net net.app.dso newcomer.name base (svRightOwnerInfo (newcomer with defaultBeneficiary = firstBeneficiary))
    >>= shouldBeRejected "Beneficiaries cannot be changed through DsoRules_UpdateSvRightOwnerInfo"
  votedAt <- getTime
  (_, rules) <- currentDsoRules net

  instruction <- voteToUpdate net newcomer.name base (svRightOwnerInfo raised)

  contractPayload net instruction `shouldReturn` UpdateSvRightOwnerInfoInstruction with
    dso = net.app.dso; name = newcomer.name; baseInfo = base; newInfo = svRightOwnerInfo raised; expiresAt = addRelTime votedAt rules.config.actionConfirmationTimeout
  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner]

  genesisCid <- svRightOwnerCidFor net net.genesisOwner.name
  newcomerState <- svRewardStateCidFor net newcomer.name
  stateBefore <- rewardStateOf net newcomer
  rulesBefore <- dsoRules net
  stranger <- allocateParty "stranger"
  executeUpdate net stranger instruction >>= shouldBeRejected "SV party is an actual SV"
  executeUpdateWith net net.sv1.party instruction genesisCid >>= shouldBeRejected contractNameMismatch
  expireUpdate net net.sv1.party instruction >>= shouldBeRejected "Ledger time is strictly before deadline 'updateSvRightOwnerInfoInstruction.expiresAt'"
  executeUpdate net net.sv3.party instruction >>= shouldSucceed

  svRightOwners net `shouldReturn` [raised, net.genesisOwner]
  expectActive net newcomerState
  rewardStateOf net raised `shouldReturn` stateBefore
  dsoRules net `shouldReturn` rulesBefore

test_shouldMergeTheVotedFieldsWithTheSvRightOwnersConcurrentChanges = withTwoSvRightOwners $ \net newcomer -> do
  votedOn <- allocateParty "voted-on-beneficiary"
  addedLater <- allocateParty "added-later-beneficiary"
  setBeneficiaries net newcomer (sharingWith [(votedOn, 0.2)])
  let base = svRightOwnerInfo (newcomer with beneficiaries = sharingWith [(votedOn, 0.2)])
  raise <- voteToUpdate net newcomer.name base (withRewardWeight tier1RewardWeight base)
  -- Voted against an info without the assignment, so the vote adds it with the beneficiaries of that time.
  readd <- voteToUpdate net newcomer.name (base with svNodeAssignments = TextMap.empty) base

  setBeneficiaries net newcomer (sharingWith [(votedOn, 0.2), (addedLater, 0.3)])

  executeUpdate net net.sv1.party readd >>= shouldBeRejected "Beneficiaries cannot be changed through DsoRules_UpdateSvRightOwnerInfo"
  executeUpdate net net.sv1.party raise >>= shouldSucceed

  svRightOwners net `shouldReturn`
    [(newcomer with rewardWeight = tier1RewardWeight; beneficiaries = sharingWith [(votedOn, 0.2), (addedLater, 0.3)]), net.genesisOwner]

test_shouldMoveAnOrphanedSvRightOwnerToAnotherSvNodeOperatorAfterItsHostIsOffboarded = withTwoSvRightOwners $ \net newcomer -> do
  latecomer <- newSvRightOwner "latecomer" net.sv2
  addition <- voteToAdd net latecomer
  let base = svRightOwnerInfo newcomer
      moved = newcomer with hostedBy = net.sv3
  raise <- voteToUpdate net newcomer.name base (withRewardWeight tier1RewardWeight base)
  move <- voteToUpdate net newcomer.name base (svRightOwnerInfo moved)

  offboardSvNodeOperator net net.sv2

  svNodeOperators net `shouldReturn` [net.sv1, net.sv3, net.sv4]
  execute net net.sv1.party addition >>= shouldBeRejected "SV right owner's node operator must exist"
  executeUpdate net net.sv1.party raise >>= shouldBeRejected "SV right owner's node operator must exist"
  mintThrough net net.sv3 newcomer.name >>= shouldBeRejected "SV Right Owner mints through this SV Node Operator"

  executeUpdate net net.sv1.party move >>= shouldSucceed
  runNextIssuance net.app
  mintThrough net net.sv3 newcomer.name >>= shouldSucceed
  svRightOwners net `shouldReturn` [moved, net.genesisOwner]

test_shouldLetAVoteRotateTheSvRightOwnerPartyAndKeepItsRewardState = withTwoSvRightOwners $ \net newcomer -> do
  successor <- allocateParty "successor"
  let rotated = newcomer with party = successor
  stateBefore <- rewardStateOf net newcomer
  instruction <- voteToUpdate net newcomer.name (svRightOwnerInfo newcomer) (svRightOwnerInfo rotated)

  executeUpdate net net.sv1.party instruction >>= shouldSucceed

  svRightOwners net `shouldReturn` [rotated, net.genesisOwner]
  rewardStateOf net rotated `shouldReturn` stateBefore

test_shouldLetTheSvRightOwnerRotateItsPartyAndThenOnlyTheNewPartyActForIt = withTwoSvRightOwners $ \net newcomer -> do
  beneficiary <- allocateParty "beneficiary"
  successor <- allocateParty "successor"
  stranger <- allocateParty "stranger"
  cotenant <- newSvRightOwner "cotenant" net.sv2
  addSvRightOwner net cotenant
  setBeneficiaries net newcomer (sharingWith [(beneficiary, 0.2)])
  runNextIssuance net.app
  mintThrough net net.sv2 newcomer.name >>= shouldSucceed
  -- Rotating the party leaves the default beneficiary with the old party.
  let rotated = newcomer with party = successor; beneficiaries = sharingWith [(beneficiary, 0.2)]; defaultBeneficiary = newcomer.party
      split = sharingWith [(beneficiary, 0.5)]
      notOwner = "The party is rotated by the SV right owner itself"
  genesisCid <- svRightOwnerCidFor net net.genesisOwner.name
  newcomerState <- svRewardStateCidFor net newcomer.name
  stateBefore <- rewardStateOf net newcomer

  servedByScan net newcomer.name >>= \disclosures -> rotatePartyAs net newcomer.party newcomer successor >>= shouldSucceedDisclosing disclosures

  svRightOwners net `shouldReturn` [cotenant, rotated, net.genesisOwner]
  expectActive net newcomerState
  rewardStateOf net rotated `shouldReturn` stateBefore

  rotatePartyAs net newcomer.party rotated newcomer.party >>= shouldBeRejected notOwner
  rotatePartyAs net net.sv2.party rotated stranger >>= shouldBeRejected notOwner
  rotatePartyAs net net.app.dso rotated stranger >>= shouldBeRejected notOwner
  rotatePartyAs net cotenant.party rotated stranger >>= shouldBeRejected notOwner
  rotatePartyAs net stranger rotated stranger >>= shouldBeRejected notOwner
  setBeneficiariesAs net newcomer.party rotated split >>= shouldBeRejected "Beneficiaries are set by the SV right owner itself"
  rotatePartyWith net successor newcomer.name stranger genesisCid >>= shouldBeRejected contractNameMismatch
  setBeneficiariesAs net successor rotated split >>= shouldSucceed

  svRightOwners net `shouldReturn` [cotenant, (rotated with beneficiaries = split), net.genesisOwner]

test_shouldLetAnUpdateThatCanNoLongerSucceedOnlyExpireFromTheDeadline = withTwoSvRightOwners $ \net newcomer -> do
  let genesisBase = svRightOwnerInfo net.genesisOwner
  raise <- voteToUpdate net newcomer.name (svRightOwnerInfo newcomer) (svRightOwnerInfo (newcomer with rewardWeight = tier1RewardWeight))
  genesisUpdate <- voteToUpdate net net.genesisOwner.name genesisBase (withRewardWeight tier2RewardWeight genesisBase)
  removal <- voteToRemove net newcomer.name
  removedCid <- svRightOwnerCidFor net newcomer.name
  stranger <- allocateParty "stranger"

  executeRemoval net net.sv1.party removal >>= shouldSucceed
  executeUpdateWith net net.sv1.party raise removedCid >>= shouldBeRejected "SV right owner \"newcomer\" exists"
  expireUpdate net stranger raise >>= shouldBeRejected "SV party is an actual SV"
  expireUpdate net net.sv1.party raise >>= shouldBeRejected "Ledger time is strictly before deadline 'updateSvRightOwnerInfoInstruction.expiresAt'"
  instructionExpiresAt net genesisUpdate >>= setTime
  executeUpdate net net.sv1.party genesisUpdate >>= shouldBeRejected "Ledger time is at or past deadline 'updateSvRightOwnerInfoInstruction.expiresAt'"
  expireUpdate net net.sv1.party raise >>= shouldSucceed
  expireUpdate net net.sv1.party genesisUpdate >>= shouldSucceed

  expectArchived net raise
  expectArchived net genesisUpdate
  svRightOwners net `shouldReturn` [net.genesisOwner]

test_shouldApplyEveryPassedUpdateAndGovernCoHostedSvRightOwnersIndependently = withTwoSvRightOwners $ \net newcomer -> do
  cotenant <- newSvRightOwner "cotenant" net.sv2
  addSvRightOwner net cotenant
  successor <- allocateParty "successor"
  let base = svRightOwnerInfo newcomer
      raised = newcomer with rewardWeight = tier1RewardWeight
      moved = raised with hostedBy = net.sv3
      rotated = cotenant with party = successor
  raise <- voteToUpdate net newcomer.name base (svRightOwnerInfo raised)
  move <- voteToUpdate net newcomer.name base (svRightOwnerInfo (newcomer with hostedBy = net.sv3))
  rotation <- voteToUpdate net cotenant.name (svRightOwnerInfo cotenant) (svRightOwnerInfo rotated)
  removal <- voteToRemove net cotenant.name

  executeUpdate net net.sv3.party raise >>= shouldSucceed
  executeUpdate net net.sv4.party rotation >>= shouldSucceed
  executeUpdate net net.sv1.party move >>= shouldSucceed

  svRightOwners net `shouldReturn` [rotated, moved, net.genesisOwner]
  newcomerCid <- svRightOwnerCidFor net newcomer.name
  newcomerState <- svRewardStateCidFor net newcomer.name
  stateBefore <- rewardStateOf net moved
  executeRemoval net net.sv1.party removal >>= shouldSucceed

  expectActive net newcomerCid
  expectActive net newcomerState
  rewardStateOf net moved `shouldReturn` stateBefore
  svRightOwners net `shouldReturn` [moved, net.genesisOwner]
  svRewardStateNames net `shouldReturn` [newcomer.name, net.genesisOwner.name]

test_shouldKeepOneRewardStatePerSvNodeAssignmentWhenSplittingAndRetiringSvNodes = withTwoSvRightOwners $ \net newcomer -> do
  let base = svRightOwnerInfo newcomer
      first = onlyAssignment base
      firstId = svNodeAssignmentIdOf newcomer.name
      secondId = newcomer.name <> "-2"
      second = first with svNodeName = net.sv3.name; rewardWeight = 1000
      -- The owner's weight at sv2 is split across sv2 and sv3; later its sv2 assignment is retired into sv3.
      split = base with svNodeAssignments = TextMap.fromList [(firstId, first with rewardWeight = first.rewardWeight - 1000), (secondId, second)]
      retired = base with svNodeAssignments = TextMap.fromList [(secondId, second with rewardWeight = first.rewardWeight)]
      rewardStates = do
        states <- queryFilter @SvRightsOwnerRewardState net.app.dso (\state -> state.svRightsOwnerName == newcomer.name)
        pure $ sort [(state.svNodeAssignmentId, state.state.lastRoundCollected) | (_, state) <- states]
      rewardStateCid svNodeAssignmentId = do
        [(stateCid, _)] <- queryFilter @SvRightsOwnerRewardState net.app.dso (\state -> state.svRightsOwnerName == newcomer.name && state.svNodeAssignmentId == svNodeAssignmentId)
        pure stateCid
  firstStateCid <- rewardStateCid firstId
  firstState <- rewardStateOf net newcomer
  [_, (_, latestUsableRound)] <- getOpenRoundsSorted net.app

  voteToUpdate net newcomer.name base split >>= executeUpdate net net.sv1.party >>= shouldSucceed

  expectActive net firstStateCid
  rewardStates `shouldReturn` [(firstId, firstState.lastRoundCollected), (secondId, latestUsableRound.round)]
  runNextIssuance net.app
  (openRoundCid, openRound) <- last <$> getOpenRoundsSorted net.app
  ownerCid <- svRightOwnerCidFor net newcomer.name
  secondStateCid <- rewardStateCid secondId
  let mintFor svOperator stateCid = mintWith net svOperator openRoundCid (TextMap.fromList [(newcomer.name, (ownerCid, stateCid))])
  mintFor net.sv3.party firstStateCid >>= shouldBeRejected contractNameMismatch
  mintFor newcomer.hostedBy.party firstStateCid >>= shouldSucceed
  mintFor net.sv3.party secondStateCid >>= shouldSucceed
  couponsMintedFor net newcomer openRound.round `shouldReturn` [(newcomer.party, 1000), (newcomer.party, first.rewardWeight - 1000)]

  retirement <- voteToUpdate net newcomer.name split retired
  executeUpdate net net.sv1.party retirement >>= shouldBeRejected "Reward states are provided for exactly the SV node assignments"
  firstStateCid <- rewardStateCid firstId
  executeUpdateRemoving net net.sv1.party retirement ownerCid (TextMap.fromList [(firstId, firstStateCid)]) >>= shouldSucceed

  expectArchived net firstStateCid
  rewardStates `shouldReturn` [(secondId, openRound.round)]
  runNextIssuance net.app
  (nextRoundCid, nextRound) <- last <$> getOpenRoundsSorted net.app
  ownerCid <- svRightOwnerCidFor net newcomer.name
  secondStateCid <- rewardStateCid secondId
  let mintNextFor svOperator = mintWith net svOperator nextRoundCid (TextMap.fromList [(newcomer.name, (ownerCid, secondStateCid))])
  mintNextFor newcomer.hostedBy.party >>= shouldBeRejected "SV Right Owner mints through this SV Node Operator"
  mintNextFor net.sv3.party >>= shouldSucceed
  couponsMintedFor net newcomer nextRound.round `shouldReturn` [(newcomer.party, first.rewardWeight)]

test_shouldRefuseUpdatingAnSvRightOwnerUnderLegacyWeightManagement = withLegacyWeights $ \net -> do
  let base = svRightOwnerInfo net.genesisOwner

  updateAs net net.app.dso net.genesisOwner.name base base >>= shouldBeRejected "svRightOwners are tracked on-ledger"

test_shouldRefuseRotatingTheSvRightOwnerPartyUnderLegacyWeightManagement = withLegacyWeights $ \net -> do
  noSvRightOwner <- coerceContractId <$> dsoRules net
  rotatePartyWith net net.genesisOwner.party net.genesisOwner.name net.genesisOwner.party noSvRightOwner >>= shouldBeRejected "svRightOwners are tracked on-ledger"
