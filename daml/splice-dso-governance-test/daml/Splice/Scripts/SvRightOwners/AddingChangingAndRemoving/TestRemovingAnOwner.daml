module Splice.Scripts.SvRightOwners.AddingChangingAndRemoving.TestRemovingAnOwner where

import DA.Assert ((===))
import DA.Time (addRelTime, hours)

import Daml.Script

import Splice.DSO.SvState (RewardState(..))
import Splice.DsoRules
  ( DsoRules_ActionRequiringConfirmation(..)
  , DsoRules_CloseVoteRequest(..)
  , DsoRules_RemoveSvRightOwner(..)
  , DsoRules_UpdateSvRightOwnerBeneficiaries(..)
  , RemoveSvRightOwnerInstruction(..)
  )

import Splice.Scripts.SvRightOwners.Util.Fixture
import Splice.Scripts.SvRightOwners.Util.Governance
import Splice.Scripts.Util (getOpenRoundsSorted)

test_shouldRemoveTheSvRightOwnerButNeverTheLastOne = withOnLedgerWeights $ \net -> do
  removeIsRefusedFor net net.app.dso net.genesisOwner.name "There is more than one SV right owner"

  newcomer <- newSvRightOwner "newcomer" net.sv2
  voteToAdd net newcomer >>= execute net net.sv1
  removeIsRefusedFor net net.app.dso "no-such-owner" "SV right owner \"no-such-owner\" exists"
  removeIsRefusedFor net net.app.dso "SV1" "SV right owner \"SV1\" exists"
  removeIsRefusedFor net net.app.dso net.sv2.name "SV right owner \"sv2\" exists"
  votedAt <- getTime

  genesisRemoval <- voteToRemove net net.genesisOwner.name
  newcomerRemoval <- voteToRemove net newcomer.name

  contractPayload net genesisRemoval `shouldReturn` RemoveSvRightOwnerInstruction with
    dso = net.app.dso; name = net.genesisOwner.name; expiresAt = addRelTime votedAt (hours 4)
  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner]
  svRightOwnerNamesInDsoRules net `shouldReturn` [newcomer.name, net.genesisOwner.name]

  genesisCid <- svRightOwnerCidFor net net.genesisOwner.name
  genesisState <- svRewardStateCidFor net net.genesisOwner.name
  newcomerCid <- svRightOwnerCidFor net newcomer.name
  newcomerState <- svRewardStateCidFor net newcomer.name
  rules <- dsoRules net
  executeRemoval net rules net.sv1 genesisRemoval genesisCid genesisState
  currentRules <- dsoRules net
  executeRemovalIsRefusedFor net currentRules net.sv1.party newcomerRemoval newcomerCid newcomerState "There is more than one SV right owner"

  expectActive net newcomerRemoval
  svRightOwners net `shouldReturn` [newcomer]
  svRightOwnerNamesInDsoRules net `shouldReturn` [newcomer.name]
  svRewardStateNames net `shouldReturn` [newcomer.name]

test_shouldRejectTheWholeVoteCloseWhenTheRemovalIsNoLongerValid = withTwoSvRightOwners $ \net newcomer -> do
  instruction <- voteToRemove net newcomer.name
  staleRequest <- openVote net $
    SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with name = newcomer.name
  newcomerCid <- svRightOwnerCidFor net newcomer.name
  newcomerState <- svRewardStateCidFor net newcomer.name
  rules <- dsoRules net
  executeRemoval net rules net.sv1 instruction newcomerCid newcomerState

  currentRules <- dsoRules net
  currentAmuletRules <- amuletRules net
  refusedFor net net.sv1.party "SV right owner \"newcomer\" exists" $
    exerciseCmd currentRules DsoRules_CloseVoteRequest with
      requestCid = staleRequest
      amuletRulesCid = Some currentAmuletRules
      sv = Some net.sv1.party

  expectActive net staleRequest
  svRightOwners net `shouldReturn` [net.genesisOwner]

test_shouldLetOnlyOneOfTwoRemovalInstructionsForTheSameSvRightOwnerExecute = withTwoSvRightOwners $ \net newcomer -> do
  firstInstruction <- voteToRemove net newcomer.name
  secondInstruction <- voteToRemove net newcomer.name
  expectActive net firstInstruction
  expectActive net secondInstruction
  newcomerCid <- svRightOwnerCidFor net newcomer.name
  newcomerState <- svRewardStateCidFor net newcomer.name
  rules <- dsoRules net

  executeRemoval net rules net.sv1 firstInstruction newcomerCid newcomerState
  currentRules <- dsoRules net
  executeRemovalIsRefusedFor net currentRules net.sv1.party secondInstruction newcomerCid newcomerState "SV right owner \"newcomer\" exists"

  expectActive net secondInstruction
  svRightOwners net `shouldReturn` [net.genesisOwner]

test_shouldLetAnySvOperatorExecuteTheRemovalWithTheCurrentContracts = withTwoSvRightOwners $ \net newcomer -> do
  newcomer.hostedBy === net.sv2
  instruction <- voteToRemove net newcomer.name
  staleCid <- svRightOwnerCidFor net newcomer.name
  newcomerState <- svRewardStateCidFor net newcomer.name
  genesisCid <- svRightOwnerCidFor net net.genesisOwner.name
  genesisState <- svRewardStateCidFor net net.genesisOwner.name
  rules <- dsoRules net

  submitAs net newcomer.party $ exerciseCmd rules DsoRules_UpdateSvRightOwnerBeneficiaries with
    name = newcomer.name
    svRightOwnerCid = staleCid
    beneficiaries = newcomer.beneficiaries
    rightOwner = newcomer.party
  newcomerCid <- svRightOwnerCidFor net newcomer.name
  executeRemovalIsRefusedFor net rules net.sv1.party instruction genesisCid newcomerState "Contract group identifier mismatch"
  executeRemovalIsRefusedFor net rules net.sv1.party instruction newcomerCid genesisState "Contract group identifier mismatch"

  executeRemoval net rules net.sv3 instruction newcomerCid newcomerState

  expectArchived net instruction
  expectArchived net newcomerCid
  expectArchived net newcomerState
  svRightOwners net `shouldReturn` [net.genesisOwner]
  svRightOwnerNamesInDsoRules net `shouldReturn` [net.genesisOwner.name]
  svRewardStateNames net `shouldReturn` [net.genesisOwner.name]
  svNodeOperators net `shouldReturn` [net.sv1, net.sv2, net.sv3, net.sv4]

test_shouldAllowReAddingARemovedSvRightOwnerUnderTheSameName = withTwoSvRightOwners $ \net newcomer -> do
  instruction <- voteToRemove net newcomer.name
  newcomerCid <- svRightOwnerCidFor net newcomer.name
  newcomerState <- svRewardStateCidFor net newcomer.name
  rules <- dsoRules net
  executeRemoval net rules net.sv1 instruction newcomerCid newcomerState

  [_, (_, latestUsableRound)] <- getOpenRoundsSorted net.app
  readded <- newSvRightOwner newcomer.name net.sv3
  voteToAdd net readded >>= execute net net.sv1

  svRightOwners net `shouldReturn` [readded, net.genesisOwner]
  svRewardStateNames net `shouldReturn` [readded.name, net.genesisOwner.name]
  rewardStateOf net readded `shouldReturn` RewardState with
    lastRoundCollected = latestUsableRound.round -- so the first round it can collect is latestUsableRound + 1
    numRoundsCollected = 0
    numRoundsMissed = 0
    numCouponsIssued = 0

test_shouldExpireAnUnexecutedInstructionOnlyFromTheDeadline = withTwoSvRightOwners $ \net newcomer -> do
  instruction <- voteToRemove net newcomer.name
  newcomerCid <- svRightOwnerCidFor net newcomer.name
  newcomerState <- svRewardStateCidFor net newcomer.name
  rules <- dsoRules net

  expireRemovalIsRefusedFor net rules net.sv1.party instruction "Ledger time is strictly before deadline 'removeSvRightOwnerInstruction.expiresAt'"
  instructionExpiresAt net instruction >>= setTime
  executeRemovalIsRefusedFor net rules net.sv1.party instruction newcomerCid newcomerState "Ledger time is at or past deadline 'removeSvRightOwnerInstruction.expiresAt'"

  expireRemoval net rules net.sv1 instruction

  expectArchived net instruction
  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner]
  svRightOwnerNamesInDsoRules net `shouldReturn` [newcomer.name, net.genesisOwner.name]
  svRewardStateNames net `shouldReturn` [newcomer.name, net.genesisOwner.name]

test_shouldRefuseRemovingAnSvRightOwnerUnderLegacyWeightManagement = withLegacyWeights $ \net ->
  removeIsRefusedFor net net.app.dso net.genesisOwner.name "svRightOwners are tracked on-ledger"
