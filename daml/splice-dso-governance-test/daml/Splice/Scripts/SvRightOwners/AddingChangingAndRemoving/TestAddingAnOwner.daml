module Splice.Scripts.SvRightOwners.AddingChangingAndRemoving.TestAddingAnOwner where

import qualified DA.Text as T
import DA.Time (addRelTime, hours)

import Daml.Script

import Splice.DSO.SvState (RewardState(..))
import Splice.DsoRules (AddSvRightOwnerInstruction(..))

import Splice.Scripts.SvRightOwners.Util.Fixture
import Splice.Scripts.SvRightOwners.Util.Governance
import Splice.Scripts.Util (getOpenRoundsSorted, runNextIssuance)

test_shouldAddAnSvRightOwnerThatFirstCollectsInTheNextRound = withOnLedgerWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2
  let unknownOperator = Operator with name = "no-such-operator"; party = net.sv2.party
  addIsRefusedFor net net.app.dso (newcomer with hostedBy = unknownOperator) "SV right owner's node operator must exist"
  addIsRefusedFor net net.app.dso (newcomer with name = net.genesisOwner.name) "SV right owner \"sv1\" does not exist"
  addIsRefusedFor net net.app.dso (newcomer with name = "") "SV right owner name is not empty"
  addIsRefusedFor net net.app.dso (newcomer with name = T.implode (replicate 1025 "x")) "SV right owner name is not too long"
  addIsRefusedFor net net.app.dso (newcomer with party = net.app.dso) "SV right owner party is not the DSO party"
  addIsRefusedFor net net.app.dso (newcomer with rewardWeight = -1) "Valid SvRightOwnerInfo"
  votedAt <- getTime

  instruction <- voteToAdd net newcomer

  contractPayload net instruction `shouldReturn` AddSvRightOwnerInstruction with
    dso = net.app.dso; name = newcomer.name; info = svRightOwnerInfo newcomer; expiresAt = addRelTime votedAt (hours 4)
  svRightOwners net `shouldReturn` [net.genesisOwner]

  stranger <- allocateParty "stranger"
  executeIsRefusedFor net stranger instruction "SV party is an actual SV"
  [_, (_, latestUsableRound)] <- getOpenRoundsSorted net.app
  execute net net.sv3 instruction

  expectArchived net instruction
  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner]
  svRightOwnerNamesInDsoRules net `shouldReturn` [newcomer.name, net.genesisOwner.name]
  rewardStateOf net newcomer `shouldReturn` RewardState with
    lastRoundCollected = latestUsableRound.round; numRoundsCollected = 0; numRoundsMissed = 0; numCouponsIssued = 0

  rewardCoupon net newcomer.name newcomer.name newcomer.name >>= shouldBeRejected "is greater than the last round a reward has been received for"
  runNextIssuance net.app
  rewardCoupon net newcomer.name newcomer.name newcomer.name >>= shouldSucceed

  unpaid <- (\owner -> owner with rewardWeight = 0) <$> newSvRightOwner "unpaid" net.sv3
  voteToAdd net unpaid >>= execute net net.sv1
  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner, unpaid]

test_shouldExecuteOnlyOneAdditionPerNameAndOnlyBeforeTheDeadline = withOnLedgerWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2
  firstInstruction <- voteToAdd net newcomer
  secondInstruction <- voteToAdd net newcomer
  latecomerInstruction <- newSvRightOwner "latecomer" net.sv3 >>= voteToAdd net

  execute net net.sv1 firstInstruction
  executeIsRefusedFor net net.sv2.party secondInstruction "SV right owner \"newcomer\" does not exist"
  expireIsRefusedFor net net.sv1.party secondInstruction "Ledger time is strictly before deadline 'addSvRightOwnerInstruction.expiresAt'"

  instructionExpiresAt net latecomerInstruction >>= setTime
  executeIsRefusedFor net net.sv1.party latecomerInstruction "Ledger time is at or past deadline 'addSvRightOwnerInstruction.expiresAt'"
  expire net net.sv1 secondInstruction

  expectArchived net secondInstruction
  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner]

test_shouldRefuseAddingAnSvRightOwnerUnderLegacyWeightManagement = withLegacyWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2

  addIsRefusedFor net net.app.dso newcomer "svRightOwners are tracked on-ledger"
