module Splice.Scripts.SvRightOwners.AddingChangingAndRemoving.TestAddingAnOwner where

import DA.Time (addRelTime, hours)

import Daml.Script

import Splice.DSO.SvState (RewardState(..))

import Splice.Scripts.SvRightOwners.Util.Fixture
import Splice.Scripts.SvRightOwners.Util.Governance
import Splice.Scripts.Util (getOpenRoundsSorted)

test_shouldStartWithFourSvNodeOperatorsAndOneSvRightOwner = withOnLedgerWeights $ \net -> do
  svNodeOperators net `shouldReturn` [net.sv1, net.sv2, net.sv3, net.sv4]
  svRightOwners net `shouldReturn` [net.genesisOwner]
  svRightOwnerNamesInDsoRules net `shouldReturn` [net.genesisOwner.name]

test_shouldStartWithZeroLegacyNodeOperatorWeights = withOnLedgerWeights $ \net -> do
  svLegacyNodeOperatorWeights net `shouldReturn` [(net.sv1, 0), (net.sv2, 0), (net.sv3, 0), (net.sv4, 0)]

test_shouldRefuseAddingAnOwnerWithoutTheDsosAuthority = withOnLedgerWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2

  directly net net.sv1.party (adding newcomer) >>= shouldBeRejected "requires authorizers"

test_shouldRefuseAddingAnOwnerUnderLegacyWeightManagement = withLegacyWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2

  directly net net.app.dso (adding newcomer) >>= shouldBeRejected "svRightOwners are tracked on-ledger"

test_shouldRefuseAddingAnOwnerWhoseNameIsAlreadyTaken = withOnLedgerWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2
  vote net (adding newcomer) >>= execute net net.sv1.party >>= shouldSucceed
  latecomer <- newSvRightOwner "latecomer" net.sv3

  directly net net.app.dso (adding (latecomer with name = "newcomer")) >>= shouldBeRejected "SV right owner \"newcomer\" does not exist"
  directly net net.app.dso (adding (latecomer with name = net.genesisOwner.name)) >>= shouldBeRejected "SV right owner \"sv1\" does not exist"

  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner]

test_shouldRefuseAddingAnOwnerHostedByAnUnknownNodeOperator = withOnLedgerWeights $ \net -> do
  let unknownOperator = Operator with name = "no-such-operator"; party = net.sv2.party
  newcomer <- newSvRightOwner "newcomer" unknownOperator

  directly net net.app.dso (adding newcomer) >>= shouldBeRejected "SV right owner's node operator must exist"

test_shouldOnlyRecordAnInstructionWhenTheVotePasses = withOnLedgerWeights $ \net -> do
  instruction <- newSvRightOwner "newcomer" net.sv2 >>= vote net . adding

  expectActive net instruction
  svRightOwners net `shouldReturn` [net.genesisOwner]

test_shouldSetTheInstructionDeadlineFourHoursAfterTheVote = withOnLedgerWeights $ \net -> do
  votedAt <- getTime

  instruction <- newSvRightOwner "newcomer" net.sv2 >>= vote net . adding

  instructionExpiresAt net instruction `shouldReturn` addRelTime votedAt (hours 4)

test_shouldAddTheOwnerWhenTheInstructionIsExecuted = withOnLedgerWeights $ \net -> do
  let host = net.sv2
      someOtherOperator = net.sv3
  newcomer <- newSvRightOwner "newcomer" host
  instruction <- vote net (adding newcomer)
  [_, (_, latestUsableRound)] <- getOpenRoundsSorted net.app

  execute net someOtherOperator.party instruction >>= shouldSucceed

  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner]

  rewardStateOf net newcomer `shouldReturn` RewardState with
    lastRoundCollected = latestUsableRound.round -- so the first round it can collect is latestUsableRound + 1
    numRoundsCollected = 0
    numRoundsMissed = 0
    numCouponsIssued = 0

  expectArchived net instruction

test_shouldRefuseExecutionByAPartyThatRunsNoSvNode = withOnLedgerWeights $ \net -> do
  instruction <- newSvRightOwner "newcomer" net.sv2 >>= vote net . adding
  stranger <- allocateParty "stranger"

  execute net stranger instruction >>= shouldBeRejected "SV party is an actual SV"
  execute net net.app.dso instruction >>= shouldBeRejected "SV party is an actual SV"

  expectActive net instruction

test_shouldRefuseASecondExecutionOfTheInstruction = withOnLedgerWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2
  instruction <- vote net (adding newcomer)

  execute net net.sv1.party instruction >>= shouldSucceed
  execute net net.sv2.party instruction >>= shouldBeRejected "Could not find contract"

  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner]

test_shouldRefuseExecutionForAnOwnerWhoseInfoIsInvalid = withOnLedgerWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2

  instruction <- vote net (adding (newcomer with rewardWeight = -1))

  execute net net.sv1.party instruction >>= shouldBeRejected "Template precondition violated"

  expectActive net instruction
  svRightOwners net `shouldReturn` [net.genesisOwner]

test_shouldAddSeveralOwners = withOnLedgerWeights $ \net -> do
  alpha <- newSvRightOwner "alpha" net.sv2
  beta <- newSvRightOwner "beta" net.sv3

  vote net (adding alpha) >>= execute net net.sv1.party >>= shouldSucceed
  vote net (adding beta) >>= execute net net.sv1.party >>= shouldSucceed

  svRightOwners net `shouldReturn` [alpha, beta, net.genesisOwner]

test_shouldAddAnOwnerWithNoRewardWeight = withOnLedgerWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2
  let unpaid = newcomer with rewardWeight = 0

  vote net (adding unpaid) >>= execute net net.sv1.party >>= shouldSucceed

  svRightOwners net `shouldReturn` [unpaid, net.genesisOwner]

test_shouldAddAnOwnerNamedAfterAnSvNodeOperator = withOnLedgerWeights $ \net -> do
  namedAfterSv2 <- newSvRightOwner "sv2" net.sv2

  vote net (adding namedAfterSv2) >>= execute net net.sv1.party >>= shouldSucceed

  svRightOwners net `shouldReturn` [net.genesisOwner, namedAfterSv2]

test_shouldOnlyAllowExpiryOfASecondInstructionForTheSameName = withOnLedgerWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2
  firstInstruction <- vote net (adding newcomer)
  secondInstruction <- vote net (adding newcomer)

  execute net net.sv1.party firstInstruction >>= shouldSucceed
  execute net net.sv2.party secondInstruction >>= shouldBeRejected "SV right owner \"newcomer\" does not exist"

  instructionExpiresAt net secondInstruction >>= setTime
  expire net net.sv1.party secondInstruction >>= shouldSucceed

  expectArchived net secondInstruction
  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner]

test_shouldRefuseExpiryBeforeTheDeadline = withOnLedgerWeights $ \net -> do
  instruction <- newSvRightOwner "newcomer" net.sv2 >>= vote net . adding

  expire net net.sv1.party instruction >>= shouldBeRejected "Ledger time is strictly before deadline 'addSvRightOwnerInstruction.expiresAt'"

  expectActive net instruction

test_shouldRefuseExecutionAtOrPastTheDeadline = withOnLedgerWeights $ \net -> do
  instruction <- newSvRightOwner "newcomer" net.sv2 >>= vote net . adding
  instructionExpiresAt net instruction >>= setTime

  execute net net.sv1.party instruction >>= shouldBeRejected "Ledger time is at or past deadline 'addSvRightOwnerInstruction.expiresAt'"
  expire net net.sv1.party instruction >>= shouldSucceed

  expectArchived net instruction
  svRightOwners net `shouldReturn` [net.genesisOwner]

test_shouldRefuseExpiryByAPartyThatRunsNoSvNode = withOnLedgerWeights $ \net -> do
  instruction <- newSvRightOwner "newcomer" net.sv2 >>= vote net . adding
  stranger <- allocateParty "stranger"
  instructionExpiresAt net instruction >>= setTime

  expire net stranger instruction >>= shouldBeRejected "SV party is an actual SV"
  expire net net.app.dso instruction >>= shouldBeRejected "SV party is an actual SV"

  expectActive net instruction

test_shouldRefuseExpiryOfAnExecutedInstruction = withOnLedgerWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2
  instruction <- vote net (adding newcomer)
  expiresAt <- instructionExpiresAt net instruction

  execute net net.sv1.party instruction >>= shouldSucceed
  setTime expiresAt
  expire net net.sv1.party instruction >>= shouldBeRejected "Could not find contract"

  svRightOwners net `shouldReturn` [newcomer, net.genesisOwner]
