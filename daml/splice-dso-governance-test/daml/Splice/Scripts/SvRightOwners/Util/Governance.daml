module Splice.Scripts.SvRightOwners.Util.Governance where

import DA.Action (unless)
import DA.Functor (void)
import DA.Text (isInfixOf)

import Daml.Script

import qualified Splice.Amulet.SvRightOwner as Amulet
import Splice.DsoRules
  ( ActionRequiringConfirmation(..)
  , AddSvRightOwnerInstruction
  , DsoRules
  , DsoRules_ActionRequiringConfirmation(..)
  , DsoRules_AddSvRightOwner(..)
  , DsoRules_ExecuteAddSvRightOwnerInstruction(..)
  , DsoRules_ExpireAddSvRightOwnerInstruction(..)
  , DsoRules_UpdateSvRightOwnerInfo(..)
  , DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction(..)
  , UpdateSvRightOwnerInfoInstruction
  )

import qualified Splice.Scripts.DsoTestUtils as DsoTestUtils
import qualified Splice.Scripts.Util as AmuletScripts
import Splice.Scripts.SvRightOwners.Util.Fixture

addChoiceFor : SvRightOwner -> DsoRules_AddSvRightOwner
addChoiceFor owner = DsoRules_AddSvRightOwner with
  name = owner.name
  info = svRightOwnerInfo owner

voteToAdd : Network -> SvRightOwner -> Script (ContractId AddSvRightOwnerInstruction)
voteToAdd net owner = instructionRecordedBy net $
  DsoTestUtils.initiateAndAcceptVote net.app
    [net.sv1.party, net.sv2.party, net.sv3.party, net.sv4.party]
    ARC_DsoRules with dsoAction = SRARC_AddSvRightOwner (addChoiceFor owner)

execute : Network -> Operator -> ContractId AddSvRightOwnerInstruction -> Script ()
execute net operator instructionCid = do
  command <- executeCommand net operator.party instructionCid
  submit (actAs operator.party <> readAs net.app.dso) command

executeIsRefusedFor : Network -> Party -> ContractId AddSvRightOwnerInstruction -> Text -> Script ()
executeIsRefusedFor net party instructionCid refusalReason = do
  command <- executeCommand net party instructionCid
  refusedFor net party refusalReason command

expire : Network -> Operator -> ContractId AddSvRightOwnerInstruction -> Script ()
expire net operator instructionCid = do
  command <- expireCommand net operator.party instructionCid
  submit (actAs operator.party <> readAs net.app.dso) command

expireIsRefusedFor : Network -> Party -> ContractId AddSvRightOwnerInstruction -> Text -> Script ()
expireIsRefusedFor net party instructionCid refusalReason = do
  command <- expireCommand net party instructionCid
  refusedFor net party refusalReason command

instructionExpiresAt : Network -> ContractId AddSvRightOwnerInstruction -> Script Time
instructionExpiresAt net instructionCid = do
  Some instruction <- queryContractId net.app.dso instructionCid
  pure instruction.expiresAt

addIsRefusedFor : Network -> Party -> SvRightOwner -> Text -> Script ()
addIsRefusedFor net party owner refusalReason = do
  command <- dsoRulesCommand net $ \dsoRulesCid -> exerciseCmd dsoRulesCid (addChoiceFor owner)
  refusedFor net party refusalReason command

executeCommand : Network -> Party -> ContractId AddSvRightOwnerInstruction -> Script (Commands ())
executeCommand net svOperator instructionCid = do
  openMiningRoundTriple <- DsoTestUtils.getOpenMiningRoundTriple net.app
  dsoRulesCommand net $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteAddSvRightOwnerInstruction with
      instructionCid; openMiningRoundTriple; svOperator

expireCommand : Network -> Party -> ContractId AddSvRightOwnerInstruction -> Script (Commands ())
expireCommand net svOperator instructionCid = dsoRulesCommand net $ \dsoRulesCid ->
  exerciseCmd dsoRulesCid DsoRules_ExpireAddSvRightOwnerInstruction with
    instructionCid; sv = Some svOperator

dsoRulesCommand : Network -> (ContractId DsoRules -> Commands a) -> Script (Commands ())
dsoRulesCommand net mkCommands = do
  (dsoRulesCid, _) <- currentDsoRules net
  pure $ void $ mkCommands dsoRulesCid

refusedFor : Network -> Party -> Text -> Commands () -> Script ()
refusedFor net party refusalReason command = do
  outcome <- trySubmit (actAs party <> readAs net.app.dso) command
  case outcome of
    Right _ -> fail $ "expected a refusal because: " <> refusalReason
    Left failure -> do
      let reported = case failure of
            FailureStatusError status -> status.message
            other -> show other
      unless (refusalReason `isInfixOf` reported) $
        fail $ "expected a refusal because " <> show refusalReason <> ", not: " <> reported

instructionRecordedBy : Network -> Script () -> Script (ContractId AddSvRightOwnerInstruction)
instructionRecordedBy net governanceStep = do
  let pendingInstructions = map fst <$> query @AddSvRightOwnerInstruction net.app.dso
  before <- pendingInstructions
  governanceStep
  after <- pendingInstructions
  case [instructionCid | instructionCid <- after, instructionCid `notElem` before] of
    [instructionCid] -> pure instructionCid
    _ -> fail "expected exactly one instruction to be recorded"

addSvRightOwner : AmuletScripts.AmuletApp -> (Party, Party, Party, Party) -> Text -> Party -> Script ()
addSvRightOwner app (sv1, sv2, sv3, sv4) name rightOwnerParty = do
  DsoTestUtils.initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_AddSvRightOwner DsoRules_AddSvRightOwner with
      name
      info = svRightOwnerInfoFor rightOwnerParty tier2RewardWeight name
  [(instructionCid, _)] <- query @AddSvRightOwnerInstruction app.dso
  openMiningRoundTriple <- DsoTestUtils.getOpenMiningRoundTriple app
  DsoTestUtils.svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteAddSvRightOwnerInstruction with
      instructionCid; openMiningRoundTriple; svOperator = sv1

updateSvWeight : AmuletScripts.AmuletApp -> (Party, Party, Party, Party) -> Text -> Int -> Script ()
updateSvWeight app (sv1, sv2, sv3, sv4) ownerName weight = do
  [(svRightOwnerCid, owner)] <- queryFilter @Amulet.SvRightOwner app.dso (\owner -> owner.name == ownerName)
  DsoTestUtils.initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
      name = ownerName
      baseInfo = owner.info
      newInfo = owner.info with rewardWeight = weight
  [(instructionCid, _)] <- query @UpdateSvRightOwnerInfoInstruction app.dso
  DsoTestUtils.svSubmits app sv1 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
      instructionCid; svRightOwnerCid; svOperator = sv1
