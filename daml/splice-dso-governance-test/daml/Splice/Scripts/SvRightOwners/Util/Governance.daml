module Splice.Scripts.SvRightOwners.Util.Governance where

import DA.Functor (void)
import DA.List (last)
import qualified DA.Map as Map
import qualified DA.TextMap as TextMap

import Daml.Script

import qualified Splice.Amulet.SvRightOwner as Amulet
import Splice.DSO.SvState (SvRewardState)
import Splice.DsoRules

import qualified Splice.Scripts.DsoTestUtils as DsoTestUtils
import qualified Splice.Scripts.Util as AmuletScripts
import Splice.Scripts.SvRightOwners.Util.Fixture

addChoiceFor : SvRightOwner -> DsoRules_AddSvRightOwner
addChoiceFor owner = DsoRules_AddSvRightOwner with
  name = owner.name
  info = svRightOwnerInfo owner

voteToAdd : Network -> SvRightOwner -> Script (ContractId AddSvRightOwnerInstruction)
voteToAdd net owner = instructionRecordedBy net $ passVote net $ SRARC_AddSvRightOwner (addChoiceFor owner)

execute : Network -> Party -> ContractId AddSvRightOwnerInstruction -> Script Attempt
execute net svOperator instructionCid = do
  openMiningRoundTriple <- DsoTestUtils.getOpenMiningRoundTriple net.app
  attempt net svOperator (`exerciseCmd` DsoRules_ExecuteAddSvRightOwnerInstruction with instructionCid; openMiningRoundTriple; svOperator)

expire : Network -> Party -> ContractId AddSvRightOwnerInstruction -> Script Attempt
expire net svOperator instructionCid =
  attempt net svOperator (`exerciseCmd` DsoRules_ExpireAddSvRightOwnerInstruction with instructionCid; sv = Some svOperator)

addDirectly : Network -> Party -> SvRightOwner -> Script Attempt
addDirectly net party owner = attempt net party (`exerciseCmd` addChoiceFor owner)

instructionExpiresAt : (Template i, HasEnsure i, HasField "expiresAt" i Time) => Network -> ContractId i -> Script Time
instructionExpiresAt net instructionCid = do
  Some instruction <- queryContractId net.app.dso instructionCid
  pure instruction.expiresAt

-- | A passed removal vote: its instruction, and the contracts of the owner it names as they were when the vote passed.
data Removal = Removal with
    instruction : ContractId RemoveSvRightOwnerInstruction
    svRightOwnerCid : ContractId Amulet.SvRightOwner
    svRewardStateCid : ContractId SvRewardState

voteToRemove : Network -> Text -> Script Removal
voteToRemove net name = do
  instruction <- instructionRecordedBy net $ passVote net $ SRARC_RemoveSvRightOwner DsoRules_RemoveSvRightOwner with name
  svRightOwnerCid <- svRightOwnerCidFor net name
  svRewardStateCid <- svRewardStateCidFor net name
  pure Removal with instruction; svRightOwnerCid; svRewardStateCid

removeDirectly : Network -> Party -> Text -> Script Attempt
removeDirectly net party name = attempt net party (`exerciseCmd` DsoRules_RemoveSvRightOwner with name)

executeRemoval : Network -> Party -> Removal -> Script Attempt
executeRemoval net svOperator removal = dsoRules net >>= \dsoRulesCid -> executeRemovalAgainst dsoRulesCid net svOperator removal

-- | 'executeRemoval' against a DsoRules fetched earlier, which may since have been archived.
executeRemovalAgainst : ContractId DsoRules -> Network -> Party -> Removal -> Script Attempt
executeRemovalAgainst dsoRulesCid net svOperator (Removal with instruction; svRightOwnerCid; svRewardStateCid) =
  attemptAgainst dsoRulesCid net svOperator (`exerciseCmd` DsoRules_ExecuteRemoveSvRightOwnerInstruction with
    instructionCid = instruction; svRightOwnerCid; svRewardStateCid; svOperator)

expireRemoval : Network -> Party -> Removal -> Script Attempt
expireRemoval net svOperator removal =
  attempt net svOperator (`exerciseCmd` DsoRules_ExpireRemoveSvRightOwnerInstruction with instructionCid = removal.instruction; svOperator)

closeVote : Network -> Party -> ContractId VoteRequest -> Script Attempt
closeVote net sv requestCid = do
  amuletRulesCid <- amuletRules net
  attempt net sv (`exerciseCmd` DsoRules_CloseVoteRequest with requestCid; amuletRulesCid = Some amuletRulesCid; sv = Some sv)

updateOwnBeneficiaries : Network -> SvRightOwner -> Script Attempt
updateOwnBeneficiaries net owner = do
  svRightOwnerCid <- svRightOwnerCidFor net owner.name
  attempt net owner.party (`exerciseCmd` DsoRules_UpdateSvRightOwnerBeneficiaries with
    name = owner.name; svRightOwnerCid; beneficiaries = owner.beneficiaries; rightOwner = owner.party)

passVote : Network -> DsoRules_ActionRequiringConfirmation -> Script ()
passVote net dsoAction = DsoTestUtils.initiateAndAcceptVote net.app (svParties net) ARC_DsoRules with dsoAction

openVote : Network -> DsoRules_ActionRequiringConfirmation -> Script (ContractId VoteRequest)
openVote net dsoAction = DsoTestUtils.initiateAndCastVote net.app (svParties net) None ARC_DsoRules with dsoAction

withTwoSvRightOwners : (Network -> SvRightOwner -> Script ()) -> Script ()
withTwoSvRightOwners test = withOnLedgerWeights $ \net -> do
  newcomer <- newSvRightOwner "newcomer" net.sv2
  voteToAdd net newcomer >>= execute net net.sv1.party >>= shouldSucceed
  test net newcomer

attempt : Network -> Party -> (ContractId DsoRules -> Commands a) -> Script Attempt
attempt net submittedBy mkCommand = dsoRules net >>= \dsoRulesCid -> attemptAgainst dsoRulesCid net submittedBy mkCommand

attemptAgainst : ContractId DsoRules -> Network -> Party -> (ContractId DsoRules -> Commands a) -> Script Attempt
attemptAgainst dsoRulesCid net submittedBy mkCommand =
  pure Attempt with network = net; submittedBy; command = void (mkCommand dsoRulesCid)

instructionRecordedBy : forall i. (Template i, HasEnsure i) => Network -> Script () -> Script (ContractId i)
instructionRecordedBy net governanceStep = do
  let pendingInstructions = map fst <$> query @i net.app.dso
  before <- pendingInstructions
  governanceStep
  after <- pendingInstructions
  case [instructionCid | instructionCid <- after, instructionCid `notElem` before] of
    [instructionCid] -> pure instructionCid
    _ -> fail "expected exactly one instruction to be recorded"

migrationRequestedFor
  : Network -> TextMap.TextMap Amulet.SvRightOwnerInfo -> Script (ContractId MigrateToOnLedgerSvRightOwnersInstruction)
migrationRequestedFor net owners = instructionRecordedBy net $ passVote net $
  SRARC_MigrateToOnLedgerSvRightOwners DsoRules_MigrateToOnLedgerSvRightOwners with svRightOwners = owners

migrate
  : Network -> ContractId MigrateToOnLedgerSvRightOwnersInstruction -> TextMap.TextMap (ContractId SvRewardState) -> Script Attempt
migrate net instructionCid rewardStates = do
  openMiningRoundTriple <- DsoTestUtils.getOpenMiningRoundTriple net.app
  attempt net net.sv1.party (`exerciseCmd` DsoRules_ExecuteMigrateToOnLedgerSvRightOwnersInstruction with
    instructionCid; openMiningRoundTriple; svOperatorRewardStateCids = rewardStates; svOperator = net.sv1.party)

removalRequestedFor : Network -> Text -> Script (ContractId RemoveSvRightOwnerInstruction)
removalRequestedFor net name = do
  addOwnerNamed net name
  (.instruction) <$> voteToRemove net name

remove : Network -> ContractId RemoveSvRightOwnerInstruction -> Text -> Text -> Script Attempt
remove net instruction ownerName rewardStateName = do
  svRightOwnerCid <- svRightOwnerCidFor net ownerName
  svRewardStateCid <- svRewardStateCidFor net rewardStateName
  executeRemoval net net.sv1.party Removal with instruction; svRightOwnerCid; svRewardStateCid

infoUpdateRequestedFor : Network -> Text -> Script (ContractId UpdateSvRightOwnerInfoInstruction)
infoUpdateRequestedFor net name = do
  addOwnerNamed net "sv2"
  [(_, owner)] <- queryFilter @Amulet.SvRightOwner net.app.dso (\owner -> owner.name == name)
  instructionRecordedBy net $ passVote net $ SRARC_UpdateSvRightOwnerInfo DsoRules_UpdateSvRightOwnerInfo with
    name; baseInfo = owner.info; newInfo = owner.info with rewardWeight = tier2RewardWeight

updateInfo : Network -> ContractId UpdateSvRightOwnerInfoInstruction -> Text -> Script Attempt
updateInfo net instructionCid ownerName = do
  svRightOwnerCid <- svRightOwnerCidFor net ownerName
  attempt net net.sv1.party (`exerciseCmd` DsoRules_ExecuteUpdateSvRightOwnerInfoInstruction with
    instructionCid; svRightOwnerCid; svOperator = net.sv1.party)

updateBeneficiaries : Network -> Text -> Text -> Script Attempt
updateBeneficiaries net name ownerName = do
  svRightOwnerCid <- svRightOwnerCidFor net ownerName
  attempt net net.sv2.party (`exerciseCmd` DsoRules_UpdateSvRightOwnerBeneficiaries with
    name; svRightOwnerCid; beneficiaries = Map.empty; rightOwner = net.sv2.party)

rewardCoupon : Network -> Text -> Text -> Text -> Script Attempt
rewardCoupon net mapKey ownerName rewardStateName = do
  (openRoundCid, openRound) <- last <$> AmuletScripts.getOpenRoundsSorted net.app
  setTime openRound.opensAt
  [(svRightOwnerCid, owner)] <- queryFilter @Amulet.SvRightOwner net.app.dso (\owner -> owner.name == ownerName)
  svRewardStateCid <- svRewardStateCidFor net rewardStateName
  (_, dsoRules) <- currentDsoRules net
  [svOperator] <- pure [party | (party, info) <- Map.toList dsoRules.svs, info.name == owner.info.rewardNodeOperatorName]
  attempt net svOperator (`exerciseCmd` DsoRules_ReceiveSvRewardCouponV2 with
    svOperator; openRoundCid; svRightOwnerRewardInputs = TextMap.fromList [(mapKey, (svRightOwnerCid, svRewardStateCid))])

addOwnerNamed : Network -> Text -> Script ()
addOwnerNamed net name = voteToAdd net owner >>= execute net net.sv1.party >>= shouldSucceed
  where owner = SvRightOwner with name; party = net.sv2.party; hostedBy = net.sv2; rewardWeight = tier2RewardWeight; beneficiaries = Map.empty
